<%= form_with(model: warehouse_order) do |form| %>
  <% if warehouse_order.errors.any? %>
    <div box-="square" class="tui-banner tui-banner-error" style="margin-bottom: 1lh;">
      [!] <strong>Hey, slight issue:</strong>
      <ul class="error-list">
        <% warehouse_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div box-="round" style="margin-bottom: 1lh;">
    <strong>Order Details</strong>
    <div is-="separator"></div>
    <div style="margin-top: 0.5lh;">
      <div style="margin-bottom: 1lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Short title (shown to recipient)</label>
        <input type="text" name="warehouse_order[user_facing_title]" value="<%= warehouse_order.user_facing_title %>" style="width: 100%;" autofocus>
      </div>

      <div>
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Recipient email</label>
        <input type="email" name="warehouse_order[recipient_email]" value="<%= warehouse_order.recipient_email %>" style="width: 100%;">
      </div>
    </div>
  </div>

  <div box-="round" style="margin-bottom: 1lh;">
    <strong>Shipping Address</strong>
    <div is-="separator"></div>
    <div style="margin-top: 0.5lh;">
      <%= render 'addresses/primer_nested_form', form: form %>
    </div>
  </div>

  <div box-="round" style="margin-bottom: 1lh;">
    <strong>Contents</strong>
    <div is-="separator"></div>
    <div style="margin-top: 0.5lh;">
      <%= render Components::Warehouse::LineItemsEditor.new(
        form: form,
        scope: current_user&.is_admin? ? :all : :in_inventory,
        show_unit_cost: false,
        add_button_text: "Add Item"
      ) %>
    </div>
  </div>

  <div box-="round" style="margin-bottom: 1lh;">
    <strong>Options</strong>
    <div is-="separator"></div>
    <div style="margin-top: 0.5lh;">
      <div style="margin-bottom: 1lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Internal notes</label>
        <textarea name="warehouse_order[internal_notes]" rows="3" style="width: 100%;"><%= warehouse_order.internal_notes %></textarea>
      </div>

      <label>
        <input type="checkbox" name="warehouse_order[notify_on_dispatch]" value="1" <%= "checked" if warehouse_order.notify_on_dispatch %>>
        Send the recipient a "sent to warehouse" email
        <span style="display: block; color: var(--foreground2); font-size: 0.85em;">They'll get an email when it ships regardless</span>
      </label>
    </div>
  </div>

  <%= render 'shared/primer_tag_picker', form: form, taggable: warehouse_order %>

  <row gap-="1" align-="center">
    <a href="<%= warehouse_order.persisted? ? warehouse_order_path(warehouse_order) : warehouse_orders_path %>">Cancel</a>
    <button type="submit" variant-="green">✓ <%= warehouse_order.persisted? ? "Update Order" : "Create Order" %></button>
  </row>
<% end %>
