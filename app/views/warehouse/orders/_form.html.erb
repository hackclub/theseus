<%= form_with(model: warehouse_order) do |form| %>
  <% if warehouse_order.errors.any? %>
    <div class="banner banner-error mb-1">
      [!] <strong>Hey, slight issue:</strong>
      <ul class="error-list">
        <% warehouse_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="mb-1">
    <strong>Order Details</strong>
    <hr>
    <div class="mt-half">
      <div class="mb-1">
        <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Short title (shown to recipient)</label>
        <input type="text" name="warehouse_order[user_facing_title]" value="<%= warehouse_order.user_facing_title %>" class="w-100" autofocus>
      </div>

      <div>
        <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Recipient email</label>
        <input type="email" name="warehouse_order[recipient_email]" value="<%= warehouse_order.recipient_email %>" class="w-100">
      </div>
    </div>
  </section>

  <section class="mb-1">
    <strong>Shipping Address</strong>
    <hr>
    <div class="mt-half">
      <%= render 'addresses/primer_nested_form', form: form %>
    </div>
  </section>

  <section class="mb-1">
    <strong>Contents</strong>
    <hr>
    <div class="mt-half">
      <%= render Components::Warehouse::LineItemsEditor.new(
        form: form,
        scope: current_user&.is_admin? ? :all : :in_inventory,
        show_unit_cost: false,
        add_button_text: "Add Item"
      ) %>
    </div>
  </section>

  <section class="mb-1">
    <strong>Options</strong>
    <hr>
    <div class="mt-half">
      <div class="mb-1">
        <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Internal notes</label>
        <textarea name="warehouse_order[internal_notes]" rows="3" class="w-100"><%= warehouse_order.internal_notes %></textarea>
      </div>

      <label>
        <input type="checkbox" name="warehouse_order[notify_on_dispatch]" value="1" <%= "checked" if warehouse_order.notify_on_dispatch %>>
        Send the recipient a "sent to warehouse" email
        <span class="text-muted" style="display: block; font-size: 0.85em">They'll get an email when it ships regardless</span>
      </label>
    </div>
  </section>

  <% if current_user.billing_profiles.any? %>
    <section class="mb-1">
      <strong>Billing</strong>
      <hr>
      <div class="mt-half">
        <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Billing Profile</label>
        <select name="warehouse_order[billing_profile_id]" class="w-100">
          <option value="">None</option>
          <% current_user.billing_profiles.each do |profile| %>
            <option value="<%= profile.id %>" <%= "selected" if warehouse_order.billing_profile_id == profile.id %>><%= profile.organization_name %></option>
          <% end %>
        </select>
        <span class="text-muted" style="display: block; font-size: 0.85em; margin-top: 0.25rem">Which HCB organization pays for this order?</span>
        <div class="money-note mt-half">
          <span class="money-notice__glyph">$</span>
          <span>Labor ($1.80 + $0.20 per SKU) is billed when you send this order to the warehouse. Postage is billed at cost when it ships. You'll see the exact amount before anything is charged.</span>
        </div>
      </div>
    </section>
  <% end %>

  <%= render 'shared/primer_tag_picker', form: form, taggable: warehouse_order %>

  <div class="flex-row">
    <a href="<%= warehouse_order.persisted? ? warehouse_order_path(warehouse_order) : warehouse_orders_path %>">Cancel</a>
    <button type="submit" class="btn-success">✓ <%= warehouse_order.persisted? ? "Update Order" : "Create Order" %></button>
  </div>
<% end %>
