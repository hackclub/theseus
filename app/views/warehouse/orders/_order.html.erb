<tr id="<%= dom_id order %>">
  <td style="padding: 0.25lh 1ch;">
    <a href="<%= warehouse_order_path(order) %>" style="font-weight: bold; text-decoration: none;"><%= order.hc_id %></a>
    <% if order.user_facing_title.present? %>
      <span class="row-tag"><%= order.user_facing_title %></span>
    <% end %>
  </td>
  <td style="padding: 0.25lh 1ch;"><%= order.address&.name_line || "—" %></td>
  <td style="padding: 0.25lh 1ch; color: var(--foreground2);"><%= order.recipient_email %></td>
  <td style="padding: 0.25lh 1ch;">
    <%= render 'warehouse/orders/status_badge', order: order %>
  </td>
</tr>
