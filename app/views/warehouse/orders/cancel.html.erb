<% content_for :title, "Cancel order #{@warehouse_order.hc_id}" %>

<div class="page-container--xs">
  <div class="page-title-group content-section">
    <h1 class="page-title">Cancel order</h1>
    <code class="mono"><%= @warehouse_order.hc_id %></code>
  </div>

  <div box-="square" class="tui-banner tui-banner-warning" style="margin-bottom: 1lh;">
    [!] Please try to avoid needing to do this. If fulfillment is already underway at the warehouse, this will error out and you'll need to contact them directly.
  </div>

  <%= form_with url: cancel_warehouse_order_path(@warehouse_order), method: :post do |form| %>
    <div box-="round" style="margin-bottom: 2lh;">
      <div style="padding: 1lh 1ch;">
        <div style="margin-bottom: 1lh;">
          <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Reason for cancellation</label>
          <textarea name="cancellation_reason" rows="3" required style="width: 100%;"></textarea>
          <span style="color: var(--foreground2); font-size: smaller;">Visible to AGH crew</span>
        </div>
      </div>
    </div>

    <div class="page-actions">
      <a href="<%= warehouse_order_path(@warehouse_order) %>">Never mind</a>
      <button type="submit" variant-="red">× Cancel this order</button>
    </div>
  <% end %>

  <div class="back-link">
    <a href="<%= warehouse_order_path(@warehouse_order) %>">← Back to order</a>
  </div>
</div>
