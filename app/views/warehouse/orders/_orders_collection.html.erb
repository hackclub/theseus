<table class="w-100">
  <thead>
    <tr>
      <th class="text-left">Order</th>
      <th class="text-left">Recipient</th>
      <th class="text-left">Created</th>
      <th class="text-left">Status</th>
    </tr>
  </thead>
  <tbody>
    <% orders.each do |order| %>
      <tr>
        <td class="cell-pad">
          <a href="<%= warehouse_order_path(order) %>" class="link-bold"><%= order.hc_id %></a>
          <% if order.user_facing_title.present? %>
            <span class="row-tag"><%= order.user_facing_title %></span>
          <% end %>
        </td>
        <td class="cell-pad">
          <%= order.address&.name_line || "—" %>
          <% if order.recipient_email.present? %>
            <span class="text-muted"> (<%= order.recipient_email %>)</span>
          <% end %>
        </td>
        <td class="cell-pad"><%= order.created_at.strftime(order.created_at.year == Date.current.year ? "%b %d" : "%b %d, %Y") %></td>
        <td class="cell-pad">
          <%= render 'warehouse/orders/status_badge', order: order %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
