<% content_for :title, "Edit Order #{@warehouse_order.hc_id}" %>

<div class="toolbar mb-0 no-border-bottom">
  <div class="flex-row">
    <a href="<%= warehouse_order_path(@warehouse_order) %>" class="text-muted no-underline">← Order <%= @warehouse_order.hc_id %></a>
    <strong class="text-title">Edit Order</strong>
    <%= render 'warehouse/orders/status_badge', order: @warehouse_order %>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", warehouse_order: @warehouse_order %>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>Order Info</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">ID</span>
        <span><%= @warehouse_order.hc_id %></span>
        <span class="detail-label">Created</span>
        <span><%= @warehouse_order.created_at.strftime("%b %d, %Y") %></span>
        <span class="detail-label">Status</span>
        <span><%= render 'warehouse/orders/status_badge', order: @warehouse_order %></span>
        <span class="detail-label">Created by</span>
        <span><%= @warehouse_order.user&.email || "—" %></span>
      </div>
    </section>
  </div>
</div>
