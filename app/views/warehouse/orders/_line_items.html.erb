<table style="width: 100%; margin-top: 0.5lh;">
  <thead>
    <tr>
      <th style="text-align: left;">SKU</th>
      <th style="text-align: right;">Qty</th>
      <th style="text-align: right;">Cost to HC</th>
      <th style="text-align: right;">Declared</th>
    </tr>
  </thead>
  <tbody>
    <% order.line_items.each do |li| %>
      <tr>
        <td style="padding: 0.25lh 1ch;">
          <a href="<%= warehouse_sku_path(li.sku) %>" style="text-decoration: none;"><%= li.sku.name %></a>
          <span style="color: var(--foreground2);"> (<code><%= li.sku.sku %></code>)</span>
        </td>
        <td style="padding: 0.25lh 1ch; text-align: right; font-variant-numeric: tabular-nums;"><%= li.quantity %></td>
        <td style="padding: 0.25lh 1ch; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(li.sku.actual_cost_to_hc) %></td>
        <td style="padding: 0.25lh 1ch; text-align: right; font-variant-numeric: tabular-nums;">
          <% if li.sku.declared_unit_cost.zero? %>
            <span style="color: var(--red);" title="No cost data — will block dispatch">⚠ $0.00</span>
          <% else %>
            <%= number_to_currency(li.sku.declared_unit_cost) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr style="font-weight: bold;">
      <td style="padding: 0.25lh 1ch;">Total</td>
      <td></td>
      <td style="padding: 0.25lh 1ch; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(order.contents_actual_cost_to_hc) %></td>
      <td style="padding: 0.25lh 1ch; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(order.contents_declared_unit_cost) %></td>
    </tr>
  </tfoot>
</table>
