<% content_for :title, "Order #{@warehouse_order.hc_id}" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_orders_path %>" style="text-decoration: none; color: var(--foreground2);">← Orders</a>
    <strong style="font-size: 1.15em;">Order <%= @warehouse_order.hc_id %></strong>
    <%= render 'warehouse/orders/status_badge', order: @warehouse_order %>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <%= render Components::Shared::PublicId.new(value: @warehouse_order.hc_id) %>
    <% if @warehouse_order.user_facing_title.present? %>
      <span style="color: var(--foreground2);"><%= @warehouse_order.user_facing_title %></span>
    <% end %>
    <% @warehouse_order.tags.compact_blank.each do |tag| %>
      <a href="<%= tag_stats_path(tag) %>" style="text-decoration: none;"><span class="badge"><%= tag %></span></a>
    <% end %>
  </div>
  <span class="spacer"></span>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= edit_warehouse_order_path(@warehouse_order) %>">✎ Edit</a>
    <a href="<%= public_package_path(@warehouse_order) %>" target="_blank">↗ Public</a>
    <% if @warehouse_order.zenventory_url.present? %>
      <a href="<%= @warehouse_order.zenventory_url %>" target="_blank">↗ Zen</a>
    <% end %>
    <% if policy(@warehouse_order).destroy? %>
      <%= form_with url: warehouse_order_path(@warehouse_order), method: :delete, data: { turbo_confirm: "Delete this order?" }, class: "form-inline" do %>
        <button type="submit" class="btn-danger btn-sm">✕</button>
      <% end %>
    <% end %>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">

    <!-- Details -->
    <section style="margin-bottom: 1rem;">
      <strong>Details</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Created</span>
        <span><%= @warehouse_order.created_at.strftime("%b %d, %Y %H:%M") %></span>
        <span class="detail-label">Created by</span>
        <span><%= @warehouse_order.user&.email || "—" %></span>
        <% if @warehouse_order.created_via.present? %>
          <span class="detail-label">Created via</span>
          <span><%= @warehouse_order.created_via.humanize %></span>
        <% end %>
        <span class="detail-label">Source</span>
        <span><%= @warehouse_order.source_tag&.name || "—" %></span>
        <span class="detail-label">Notify</span>
        <span><%= @warehouse_order.notify_on_dispatch? ? "Yes" : "No" %></span>
        <span class="detail-label">Zenventory</span>
        <span><code><%= @warehouse_order.zenventory_id || "—" %></code></span>
      </div>
    </section>

    <!-- Contents -->
    <section style="margin-bottom: 1rem;">
      <strong>Contents</strong>
      <hr>
      <table style="margin-top: 0.5rem; width: 100%;">
        <thead>
          <tr>
            <th style="text-align: left;">SKU</th>
            <th style="text-align: right;">Qty</th>
            <th style="text-align: right;">Cost to HC</th>
            <th style="text-align: right;">Declared</th>
          </tr>
        </thead>
        <tbody>
          <% @warehouse_order.line_items.each do |li| %>
            <tr>
              <td>
                <%= link_to li.sku.name, warehouse_sku_path(li.sku) %>
                <span style="color: var(--foreground2);"><code><%= li.sku.sku %></code></span>
              </td>
              <td style="text-align: right; font-variant-numeric: tabular-nums;"><strong><%= li.quantity %></strong></td>
              <td style="text-align: right; font-variant-numeric: tabular-nums; color: var(--foreground2);"><%= number_to_currency(li.sku.actual_cost_to_hc) %></td>
              <td style="text-align: right; font-variant-numeric: tabular-nums; color: var(--foreground2);"><%= number_to_currency(li.sku.declared_unit_cost) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td><strong>Total</strong></td>
            <td style="text-align: right; font-variant-numeric: tabular-nums;"><strong><%= @warehouse_order.line_items.sum(&:quantity) %></strong></td>
            <td style="text-align: right; font-variant-numeric: tabular-nums;"><strong><%= number_to_currency(@warehouse_order.contents_actual_cost_to_hc) %></strong></td>
            <td style="text-align: right; font-variant-numeric: tabular-nums;"><strong><%= number_to_currency(@warehouse_order.contents_declared_unit_cost) %></strong></td>
          </tr>
        </tfoot>
      </table>
    </section>

    <!-- Recipient -->
    <section style="margin-bottom: 1rem;">
      <strong>Recipient</strong>
      <hr>
      <div style="margin-top: 0.5rem;">
        <strong><%= @warehouse_order.address.first_name %> <%= @warehouse_order.address.last_name %></strong><br>
        <span style="color: var(--foreground2);">
          <%= @warehouse_order.address.line_1 %><br>
          <% if @warehouse_order.address.line_2.present? %><%= @warehouse_order.address.line_2 %><br><% end %>
          <%= @warehouse_order.address.city %>, <%= @warehouse_order.address.state %> <%= @warehouse_order.address.postal_code %><br>
          <%= ISO3166::Country[@warehouse_order.address.country]&.common_name || @warehouse_order.address.country %>
        </span>
        <% if @warehouse_order.recipient_email.present? %>
          <hr style="margin:0.5rem 0">
          <span style="color: var(--foreground2);">✉</span> <%= link_to @warehouse_order.recipient_email, "mailto:#{@warehouse_order.recipient_email}" %>
        <% end %>
      </div>
    </section>

    <% if @warehouse_order.mailed? %>
      <!-- Shipping -->
      <section style="margin-bottom: 1rem;">
        <strong>Shipping</strong>
        <hr>
        <div class="detail-grid" style="margin-top: 0.5rem;">
          <span class="detail-label">Carrier</span>
          <span><%= @warehouse_order.pretty_via %></span>
          <% if @warehouse_order.tracking_number.present? %>
            <span class="detail-label">Tracking</span>
            <span>
              <% if @warehouse_order.tracking_url.present? %>
                <%= link_to @warehouse_order.tracking_number, @warehouse_order.tracking_url, target: "_blank" %>
              <% else %>
                <code><%= @warehouse_order.tracking_number %></code>
              <% end %>
            </span>
          <% end %>
          <% if @warehouse_order.mailed_at.present? %>
            <span class="detail-label">Shipped</span>
            <span><%= @warehouse_order.mailed_at.strftime("%b %d, %Y") %></span>
          <% end %>
        </div>
        <% if @warehouse_order.might_be_slow? %>
          <div style="margin-top: 0.5rem;">
            <div class="banner banner-warning">⚠ International shipping may take 2–4 weeks</div>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if @warehouse_order.batch.present? %>
      <section style="margin-bottom: 1rem;">
        <strong>Batch</strong>
        <hr>
        <div style="margin-top: 0.5rem;">
          <div style="display:flex;align-items:center;justify-content:space-between">
            <span>
              <strong>Batch #<%= @warehouse_order.batch.id %></strong>
              <span style="color: var(--foreground2);"><%= @warehouse_order.batch.aasm.current_state.to_s.titleize %></span>
            </span>
            <a href="<%= letter_batch_path(@warehouse_order.batch) %>">View Batch →</a>
          </div>
        </div>
      </section>
    <% end %>

    <% if @warehouse_order.internal_notes.present? %>
      <section style="margin-bottom: 1rem;">
        <strong>Internal Notes</strong>
        <hr>
        <pre style="margin: 0.5rem 0 0; white-space: pre-wrap;"><%= @warehouse_order.internal_notes %></pre>
      </section>
    <% end %>

    <%= render partial: "admin_inspector", locals: { record: @warehouse_order } %>
    <% inspector_toggle :line_items %>
  </div>

  <div class="show-sidebar">
    <!-- Actions -->
    <section style="margin-bottom: 1rem;">
      <strong>Actions</strong>
      <hr>
      <div style="margin-top: 0.5rem;">
        <% has_action = false %>

        <% if policy(@warehouse_order).send_to_warehouse? && @warehouse_order.may_mark_dispatched? %>
          <% has_action = true %>
          <%= form_with url: send_to_warehouse_warehouse_order_path(@warehouse_order), method: :post do %>
            <button type="submit" class="btn-success" style="width: 100%;">✓ Send to Warehouse</button>
          <% end %>
        <% end %>

        <% if @warehouse_order.may_mark_canceled? && policy(@warehouse_order).cancel? %>
          <% has_action = true %>
          <a href="<%= cancel_warehouse_order_path(@warehouse_order) %>" style="display: block; margin-top: 0.5rem;">
            <button class="btn-danger btn-sm" style="width: 100%;">× Cancel Order</button>
          </a>
        <% end %>

        <% unless has_action %>
          <% if @warehouse_order.mailed? %>
            <div style="text-align: center; padding: 1rem 0; color: var(--green);">
              <span style="font-size: 2em;">✓</span>
              <div style="margin-top: 0.5rem;"><strong>Shipped</strong></div>
            </div>
          <% elsif @warehouse_order.canceled_at.present? %>
            <div style="text-align: center; padding: 1rem 0; color: var(--foreground2);">
              <span style="font-size: 2em;">×</span>
              <div style="margin-top: 0.5rem;"><strong>Canceled</strong></div>
            </div>
          <% else %>
            <span style="color: var(--foreground2);">No actions available</span>
          <% end %>
        <% end %>
      </div>
    </section>

    <!-- Cost Summary -->
    <section style="margin-bottom: 1rem;">
      <strong>Cost Summary</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Contents</span>
        <span><%= number_to_currency(@warehouse_order.contents_actual_cost_to_hc) %></span>
        <span class="detail-label">Labor</span>
        <span><%= number_to_currency(@warehouse_order.labor_cost || 0) %></span>
        <span class="detail-label">Postage</span>
        <span><%= @warehouse_order.postage_cost.present? ? number_to_currency(@warehouse_order.postage_cost) : "—" %></span>
      </div>
      <hr style="margin:0.5rem 0">
      <div class="detail-grid">
        <span class="detail-label"><strong>Total</strong></span>
        <span><strong><%= number_to_currency(@warehouse_order.total_cost) %></strong></span>
      </div>
    </section>

    <!-- Timeline -->
    <section>
      <strong>Timeline</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Created</span>
        <span><%= @warehouse_order.created_at.strftime("%b %d, %Y") %></span>
        <% if @warehouse_order.dispatched_at.present? %>
          <span class="detail-label">Dispatched</span>
          <span><%= @warehouse_order.dispatched_at.strftime("%b %d, %Y") %></span>
        <% end %>
        <% if @warehouse_order.mailed_at.present? %>
          <span class="detail-label">Shipped</span>
          <span><%= @warehouse_order.mailed_at.strftime("%b %d, %Y") %></span>
        <% end %>
        <% if @warehouse_order.canceled_at.present? %>
          <span class="detail-label">Canceled</span>
          <span><%= @warehouse_order.canceled_at.strftime("%b %d, %Y") %></span>
        <% end %>
      </div>
    </section>
  </div>
</div>
