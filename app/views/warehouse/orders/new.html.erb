<% content_for :title, "New Order" %>

<div class="toolbar mb-0" style="border-bottom: none">
  <div class="flex-row">
    <a href="<%= warehouse_orders_path %>" class="text-muted" style="text-decoration: none">← Orders</a>
    <strong style="font-size: 1.15em;">New Order</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", warehouse_order: @warehouse_order %>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>Info</strong>
      <hr>
      <div class="mt-half text-muted">
        <p style="margin: 0 0 0.5rem;">Orders are sent to the warehouse for fulfillment. The recipient receives a shipping notification when it ships.</p>
        <p style="margin: 0;">Items must be in inventory to be included.</p>
      </div>
    </section>
  </div>
</div>
