<% content_for :title, @warehouse_sku.sku %>

<div class="toolbar mb-0" style="border-bottom: none">
  <div class="flex-row">
    <a href="<%= warehouse_skus_path %>" class="text-muted" style="text-decoration: none">← SKUs</a>
    <strong style="font-size: 1.15em;"><%= @warehouse_sku.sku %></strong>
    <% if @warehouse_sku.in_stock.to_i > 10 %>
      <span class="badge badge-success">In stock</span>
    <% elsif @warehouse_sku.in_stock.to_i.between?(1, 10) %>
      <span class="badge badge-warning">Low stock</span>
    <% elsif @warehouse_sku.in_stock.to_i < 0 %>
      <% if @warehouse_sku.inbound.to_i >= @warehouse_sku.in_stock.abs %>
        <span class="badge badge-warning">Backordered</span>
      <% else %>
        <span class="badge badge-danger">Backordered (!)</span>
      <% end %>
    <% else %>
      <span class="badge">No inventory</span>
    <% end %>
    <% if @warehouse_sku.ai_enabled %><span class="badge badge-info">AI</span><% end %>
    <% unless @warehouse_sku.enabled %><span class="badge">Disabled</span><% end %>
  </div>
  <div class="flex-row">
    <span class="text-muted"><%= @warehouse_sku.name %></span>
  </div>
  <span class="spacer"></span>
  <div class="flex-row">
    <% admin_tool do %>
      <a href="<%= edit_warehouse_sku_path(@warehouse_sku) %>">✎ Edit</a>
    <% end %>
    <% if @warehouse_sku.zenventory_url.present? %>
      <% admin_tool do %>
        <a href="<%= @warehouse_sku.zenventory_url %>" target="_blank">↗ Zenventory</a>
      <% end %>
    <% end %>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <section class="mb-1">
      <strong>Details</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">In Stock</span>
        <span><%= @warehouse_sku.in_stock || "—" %></span>
        <span class="detail-label">Inbound</span>
        <span><%= @warehouse_sku.inbound || "—" %></span>
        <span class="detail-label">Unit Cost</span>
        <span><%= number_to_currency(@warehouse_sku.declared_unit_cost) %></span>
        <span class="detail-label">Category</span>
        <span><%= @warehouse_sku.category&.humanize || "—" %></span>
        <% if @warehouse_sku.description.present? %>
          <span class="detail-label">Description</span>
          <span><%= @warehouse_sku.description %></span>
        <% end %>
        <% if @warehouse_sku.customs_description.present? %>
          <span class="detail-label">Customs</span>
          <span><%= @warehouse_sku.customs_description %></span>
        <% end %>
        <% if @warehouse_sku.country_of_origin.present? %>
          <span class="detail-label">Origin</span>
          <span><%= @warehouse_sku.country_of_origin %></span>
        <% end %>
        <% if @warehouse_sku.hs_code.present? %>
          <span class="detail-label">HS Code</span>
          <span><code><%= @warehouse_sku.hs_code %></code></span>
        <% end %>
        <% if @warehouse_sku.average_po_cost.present? %>
          <span class="detail-label">Avg PO Cost</span>
          <span><%= number_to_currency(@warehouse_sku.average_po_cost) %></span>
        <% end %>
        <% if @warehouse_sku.actual_cost_to_hc.present? %>
          <span class="detail-label">Actual Cost</span>
          <span><%= number_to_currency(@warehouse_sku.actual_cost_to_hc) %></span>
        <% end %>
        <span class="detail-label">Zenventory ID</span>
        <span><code><%= @warehouse_sku.zenventory_id || "—" %></code></span>
      </div>
    </section>

    <section class="mb-1">
      <strong>Recent Orders</strong>
      <hr>
      <% if @recent_orders.any? %>
        <table class="w-100 mt-half">
          <thead>
            <tr>
              <th style="text-align: left;">Order</th>
              <th style="text-align: left;">Recipient</th>
              <th style="text-align: right;">Qty</th>
              <th style="text-align: left;">Tracking</th>
              <th style="text-align: left;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_orders.each do |order| %>
              <% line_item = order.line_items.find_by(sku_id: @warehouse_sku.id) %>
              <tr>
                <td style="padding: 0.25rem 0.5rem;">
                  <a href="<%= warehouse_order_path(order) %>" style="font-weight: bold; text-decoration: none;"><%= order.hc_id %></a>
                </td>
                <td style="padding: 0.25rem 0.5rem;"><%= order.address&.name_line || "—" %></td>
                <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= line_item&.quantity || 0 %></td>
                <td style="padding: 0.25rem 0.5rem;">
                  <% if order.tracking_number.present? %>
                    <a href="<%= order.tracking_url %>" target="_blank" class="text-muted"><%= order.pretty_via %> ↗</a>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td style="padding: 0.25rem 0.5rem;">
                  <% badge_class = { "draft" => "badge", "dispatched" => "badge badge-info", "mailed" => "badge badge-success", "canceled" => "badge badge-danger", "errored" => "badge badge-danger" }[order.aasm_state] || "badge" %>
                  <span class="<%= badge_class %>"><%= order.humanized_state %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="text-muted" style="text-align: center; padding: 1rem 0">No orders yet.</div>
      <% end %>
    </section>

    <section class="mb-1">
      <strong>Purchase Orders</strong>
      <hr>
      <% if @recent_purchase_orders.any? %>
        <table class="w-100 mt-half">
          <thead>
            <tr>
              <th style="text-align: left;">PO</th>
              <th style="text-align: left;">Supplier</th>
              <th style="text-align: right;">Qty</th>
              <th style="text-align: right;">Unit Cost</th>
              <th style="text-align: left;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_purchase_orders.each do |po| %>
              <% line_item = po.line_items.find_by(sku_id: @warehouse_sku.id) %>
              <tr>
                <td style="padding: 0.25rem 0.5rem;">
                  <a href="<%= warehouse_purchase_order_path(po) %>" style="font-weight: bold; text-decoration: none;"><%= po.order_number.presence || "##{po.id}" %></a>
                </td>
                <td class="text-muted" style="padding: 0.25rem 0.5rem"><%= po.supplier_name %></td>
                <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= line_item&.quantity || 0 %></td>
                <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(line_item&.unit_cost) %></td>
                <td style="padding: 0.25rem 0.5rem;">
                  <% badge_class = { "draft" => "badge", "open" => "badge badge-info", "completed" => "badge badge-success", "deleted" => "badge badge-danger" }[po.status] || "badge" %>
                  <span class="<%= badge_class %>"><%= po.humanized_state %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="text-muted" style="text-align: center; padding: 1rem 0">No purchase orders yet.</div>
      <% end %>
    </section>

    <%= render partial: "admin_inspector", locals: { record: @warehouse_sku } %>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>Inventory</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">In Stock</span>
        <span style="font-weight: bold;"><%= @warehouse_sku.in_stock || "—" %></span>
        <span class="detail-label">Inbound</span>
        <span style="font-weight: bold;"><%= @warehouse_sku.inbound || "—" %></span>
        <span class="detail-label">Unit Cost</span>
        <span style="font-weight: bold;"><%= number_to_currency(@warehouse_sku.declared_unit_cost) %></span>
      </div>
    </section>
  </div>
</div>
