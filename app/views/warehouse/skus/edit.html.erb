<% content_for :title, "Edit SKU #{@warehouse_sku.sku}" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_sku_path(@warehouse_sku) %>" style="text-decoration: none; color: GrayText;">← <%= @warehouse_sku.sku %></a>
    <strong style="font-size: 1.15em;">Edit SKU</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", warehouse_sku: @warehouse_sku %>
  </div>
  <div class="show-sidebar">
    <section>
      <strong>SKU Info</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">SKU</span>
        <span><code><%= @warehouse_sku.sku %></code></span>
        <span class="detail-label">In Stock</span>
        <span><%= @warehouse_sku.in_stock || "—" %></span>
        <span class="detail-label">Status</span>
        <span><%= @warehouse_sku.enabled ? "Enabled" : "Disabled" %></span>
      </div>
    </section>
  </div>
</div>
