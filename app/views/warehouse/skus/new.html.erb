<% content_for :title, "New SKU" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_skus_path %>" style="text-decoration: none; color: GrayText;">← SKUs</a>
    <strong style="font-size: 1.15em;">New SKU</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", warehouse_sku: @warehouse_sku %>
  </div>
  <div class="show-sidebar">
    <section>
      <strong>Help</strong>
      <hr>
      <div style="margin-top: 0.5rem; color: GrayText;">
        Fill in the SKU code, name, and cost details. AI-enabled SKUs can be selected by the AI ordering service.
      </div>
    </section>
  </div>
</div>
