<%= form_with(model: warehouse_sku) do |form| %>
  <% if warehouse_sku.errors.any? %>
    <div class="mb-1 text-danger">
      <strong>[!] <%= pluralize(warehouse_sku.errors.count, "error") %>:</strong>
      <ul class="sku-error-list">
        <% warehouse_sku.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="mb-1">
    <strong>SKU Details</strong>
    <hr>
    <div class="mt-half">
      <div class="mb-half">
        <label class="text-muted label-block">SKU code</label>
        <input type="text" name="warehouse_sku[sku]" value="<%= warehouse_sku.sku %>" class="w-100">
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Name</label>
        <input type="text" name="warehouse_sku[name]" value="<%= warehouse_sku.name %>" class="w-100">
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Description</label>
        <textarea name="warehouse_sku[description]" rows="3" class="w-100"><%= warehouse_sku.description %></textarea>
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Category</label>
        <select name="warehouse_sku[category]" class="w-100">
          <option value="">— Select —</option>
          <% Warehouse::SKU.categories.keys.each do |cat| %>
            <option value="<%= cat %>" <%= "selected" if warehouse_sku.category == cat %>><%= cat.humanize %></option>
          <% end %>
        </select>
      </div>
    </div>
  </section>

  <section class="mb-1">
    <strong>Customs & Cost</strong>
    <hr>
    <div class="mt-half">
      <div class="mb-half">
        <label class="text-muted label-block">Declared unit cost</label>
        <div class="cost-input-row">
          <span>$</span>
          <input type="text" name="warehouse_sku[unit_cost]" value="<%= warehouse_sku.declared_unit_cost %>" class="flex-1">
        </div>
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Customs description</label>
        <textarea name="warehouse_sku[customs_description]" rows="2" class="w-100"><%= warehouse_sku.customs_description %></textarea>
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Country of origin</label>
        <input type="text" name="warehouse_sku[country_of_origin]" value="<%= warehouse_sku.country_of_origin %>" class="w-100">
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">HS code</label>
        <input type="text" name="warehouse_sku[hs_code]" value="<%= warehouse_sku.hs_code %>" class="w-100">
      </div>
      <% admin_tool do %>
        <div class="mb-half">
          <label class="text-muted label-block">Average PO cost</label>
          <div class="cost-input-row">
            <span>$</span>
            <input type="text" name="warehouse_sku[average_po_cost]" value="<%= warehouse_sku.average_po_cost %>" class="flex-1">
          </div>
        </div>
        <div class="mb-half">
          <label class="text-muted label-block">Declared unit cost override</label>
          <div class="cost-input-row">
            <span>$</span>
            <input type="text" name="warehouse_sku[declared_unit_cost_override]" value="<%= warehouse_sku.declared_unit_cost_override %>" class="flex-1">
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mb-1">
    <strong>Inventory & Settings</strong>
    <hr>
    <div class="mt-half">
      <div class="mb-half">
        <label class="text-muted label-block">In stock</label>
        <input type="number" name="warehouse_sku[in_stock]" value="<%= warehouse_sku.in_stock %>" class="w-100">
      </div>
      <% admin_tool do %>
        <div class="mb-half">
          <label class="text-muted label-block">Inbound</label>
          <input type="number" name="warehouse_sku[inbound]" value="<%= warehouse_sku.inbound %>" class="w-100">
        </div>
        <div class="mb-half">
          <label class="text-muted label-block">Zenventory ID</label>
          <input type="text" name="warehouse_sku[zenventory_id]" value="<%= warehouse_sku.zenventory_id %>" class="w-100">
        </div>
      <% end %>
      <div class="mb-half">
        <label>
          <input type="checkbox" name="warehouse_sku[ai_enabled]" value="1" <%= "checked" if warehouse_sku.ai_enabled %>>
          AI enabled
        </label>
        <div class="text-muted text-sm">Allow AI service to use this SKU</div>
      </div>
      <div class="mb-half">
        <label>
          <input type="checkbox" name="warehouse_sku[enabled]" value="1" <%= "checked" if warehouse_sku.enabled %>>
          Enabled
        </label>
        <div class="text-muted text-sm">SKU is available for ordering</div>
      </div>
    </div>
  </section>

  <div class="flex-row">
    <span class="spacer"></span>
    <a href="<%= warehouse_skus_path %>" class="text-muted">Cancel</a>
    <button type="submit" class="btn-success">✓ <%= warehouse_sku.persisted? ? "Update SKU" : "Create SKU" %></button>
  </div>
<% end %>
