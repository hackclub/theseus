<% content_for :title, @warehouse_template.name %>

<div class="toolbar mb-0 no-border-bottom">
  <div class="flex-row">
    <a href="<%= warehouse_templates_path %>" class="text-muted no-underline">← Templates</a>
    <strong class="text-title"><%= @warehouse_template.name %></strong>
    <% if @warehouse_template.public %>
      <span class="badge badge-info">Shared</span>
    <% end %>
  </div>
  <div class="flex-row">
    <%= render Components::Shared::PublicId.new(value: @warehouse_template.public_id) %>
    <span class="text-muted">by <%= @warehouse_template.user&.username || "—" %></span>
  </div>
  <span class="spacer"></span>
  <div class="flex-row">
    <% if policy(@warehouse_template).edit? %>
      <a href="<%= edit_warehouse_template_path(@warehouse_template) %>">✎ Edit</a>
    <% end %>
    <% if policy(@warehouse_template).destroy? %>
      <%= form_with url: warehouse_template_path(@warehouse_template), method: :delete, data: { turbo_confirm: "Delete this template?" }, class: "form-inline" do %>
        <button type="submit" class="btn-danger btn-sm">✕</button>
      <% end %>
    <% end %>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <section class="mb-1">
      <strong>Contents</strong>
      <hr>
      <%= render 'warehouse/orders/line_items', order: @warehouse_template %>
    </section>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>Template Info</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">Owner</span>
        <span><%= @warehouse_template.user&.username || "—" %></span>
        <span class="detail-label">Shared</span>
        <span><%= @warehouse_template.public ? "Yes" : "No" %></span>
        <span class="detail-label">Items</span>
        <span><%= @warehouse_template.line_items.count %></span>
      </div>
    </section>
  </div>
</div>
