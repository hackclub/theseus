<% content_for :title, @warehouse_template.name %>

<div class="page-container">
  <div class="page-header">
    <div>
      <div class="page-title-group">
        <h1 class="page-title"><%= @warehouse_template.name %></h1>
        <% if @warehouse_template.public %>
          <span is-="badge" variant-="blue">Shared</span>
        <% end %>
      </div>
      <p class="page-subtitle">
        Created by <%= @warehouse_template.user&.username || "unknown" %>
        · API ID: <%= render Components::Shared::PublicId.new(value: @warehouse_template.public_id) %>
      </p>
    </div>

    <div class="page-actions">
      <a href="<%= edit_warehouse_template_path(@warehouse_template) %>">✎ Edit</a>
    </div>
  </div>

  <div class="content-section">
    <h2 class="section-heading">Contents</h2>
    <%= render 'warehouse/orders/line_items', order: @warehouse_template %>
  </div>

  <div class="footer-actions">
    <%= form_with url: warehouse_template_path(@warehouse_template), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this template?" }, class: "form-inline" do %>
      <button type="submit" variant-="red" size-="small">✕ Delete template</button>
    <% end %>
  </div>

  <div class="back-link">
    <a href="<%= warehouse_templates_path %>" size-="small">← Back to templates</a>
  </div>
</div>
