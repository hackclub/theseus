<% content_for :title, @warehouse_template.name %>

<div class="page-toolbar">
  <row gap-="1" align-="center">
    <a href="<%= warehouse_templates_path %>" style="text-decoration: none; color: var(--foreground2);">← Templates</a>
    <strong style="font-size: 1.15em;"><%= @warehouse_template.name %></strong>
    <% if @warehouse_template.public %>
      <span is-="badge" variant-="blue">Shared</span>
    <% end %>
  </row>
  <row gap-="1" align-="center">
    <%= render Components::Shared::PublicId.new(value: @warehouse_template.public_id) %>
    <span style="color: var(--foreground2);">by <%= @warehouse_template.user&.username || "unknown" %></span>
  </row>
  <span class="toolbar-spacer"></span>
  <row gap-="1" align-="center">
    <a href="<%= edit_warehouse_template_path(@warehouse_template) %>" size-="small">✎ Edit</a>
    <%= form_with url: warehouse_template_path(@warehouse_template), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this template?" }, class: "form-inline" do %>
      <button type="submit" variant-="red" size-="small">✕</button>
    <% end %>
  </row>
</div>

<div class="show-layout">
  <div class="show-main">
    <div box-="round">
      <strong>Contents</strong>
      <div is-="separator"></div>
      <%= render 'warehouse/orders/line_items', order: @warehouse_template %>
    </div>
  </div>

  <div class="show-sidebar">
    <div box-="round">
      <strong>Template Info</strong>
      <div is-="separator"></div>
      <div class="detail-grid" style="margin-top: 0.5lh;">
        <span class="detail-label">Owner</span>
        <span><%= @warehouse_template.user&.username || "unknown" %></span>
        <span class="detail-label">Shared</span>
        <span><%= @warehouse_template.public ? "Yes" : "No" %></span>
        <span class="detail-label">Items</span>
        <span><%= @warehouse_template.line_items.count %></span>
      </div>
    </div>
  </div>
</div>
