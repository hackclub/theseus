<%= form_with(model: warehouse_template) do |form| %>
  <% if warehouse_template.errors.any? %>
    <div class="mb-1" style="color: var(--red)">
      <strong>[!] <%= pluralize(warehouse_template.errors.count, "error") %>:</strong>
      <ul style="margin: 0.25rem 0 0; padding-left: 1rem;">
        <% warehouse_template.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="mb-1">
    <strong>Template Details</strong>
    <hr>
    <div class="mt-half">
      <div class="mb-half">
        <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Template name <span style="color: var(--red);">*</span></label>
        <input type="text" name="warehouse_template[name]" value="<%= warehouse_template.name %>" required class="w-100">
      </div>
      <label>
        <input type="hidden" name="warehouse_template[public]" value="0">
        <input type="checkbox" name="warehouse_template[public]" value="1" <%= "checked" if warehouse_template.public %>>
        Share with all users
      </label>
    </div>
  </section>

  <section class="mb-1">
    <strong>Contents</strong>
    <hr>
    <div class="mt-half">
      <%= render Components::Warehouse::LineItemsEditor.new(
        form: form,
        scope: :in_inventory,
        show_unit_cost: false,
        add_button_text: "Add Item"
      ) %>
    </div>
  </section>

  <div class="flex-row">
    <span class="spacer"></span>
    <a href="<%= warehouse_templates_path %>" class="text-muted">Cancel</a>
    <button type="submit" class="btn-success">✓ <%= warehouse_template.persisted? ? "Update Template" : "Create Template" %></button>
  </div>
<% end %>
