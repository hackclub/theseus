<% content_for :title, "New Template" %>

<div class="toolbar mb-0 no-border-bottom">
  <div class="flex-row">
    <a href="<%= warehouse_templates_path %>" class="text-muted no-underline">← Templates</a>
    <strong class="text-title">New Template</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", warehouse_template: @warehouse_template %>
  </div>
  <div class="show-sidebar">
    <section>
      <strong>Help</strong>
      <hr>
      <div class="mt-half text-muted">
        Templates define a reusable set of line items for warehouse orders. Shared templates are visible to all users.
      </div>
    </section>
  </div>
</div>
