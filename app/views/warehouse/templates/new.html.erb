<% content_for :title, "New Template" %>

<div class="page-toolbar" style="border-bottom: none; margin-bottom: 0;">
  <row gap-="1" align-="center">
    <a href="<%= warehouse_templates_path %>" style="text-decoration: none; color: var(--foreground2);">← Templates</a>
    <strong style="font-size: 1.15em;">New Template</strong>
  </row>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", warehouse_template: @warehouse_template %>
  </div>
  <div class="show-sidebar">
    <div box-="round">
      <strong>Help</strong>
      <div is-="separator"></div>
      <div style="margin-top: 0.5lh; color: var(--foreground2);">
        Templates define a reusable set of line items for warehouse orders. Shared templates are visible to all users.
      </div>
    </div>
  </div>
</div>
