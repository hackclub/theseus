<% content_for :title, "New Template" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_templates_path %>" style="text-decoration: none; color: GrayText;">← Templates</a>
    <strong style="font-size: 1.15em;">New Template</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", warehouse_template: @warehouse_template %>
  </div>
  <div class="show-sidebar">
    <section>
      <strong>Help</strong>
      <hr>
      <div style="margin-top: 0.5rem; color: GrayText;">
        Templates define a reusable set of line items for warehouse orders. Shared templates are visible to all users.
      </div>
    </section>
  </div>
</div>
