<% content_for :title, "Purchase Order #{@purchase_order.order_number.presence || "##{@purchase_order.id}"}" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_purchase_orders_path %>" style="text-decoration: none; color: GrayText;">← Purchase Orders</a>
    <strong style="font-size: 1.15em;"><%= @purchase_order.order_number.presence || "##{@purchase_order.id}" %></strong>
    <% badge_class = { "draft" => "badge", "open" => "badge badge-info", "completed" => "badge badge-success", "deleted" => "badge badge-danger" }[@purchase_order.status] || "badge" %>
    <span class="<%= badge_class %>"><%= @purchase_order.humanized_state %></span>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <span style="color: GrayText;"><%= @purchase_order.supplier_name %></span>
  </div>
  <span class="spacer"></span>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <% if policy(@purchase_order).send_to_zenventory? && @purchase_order.may_mark_open? %>
      <%= form_with url: send_to_zenventory_warehouse_purchase_order_path(@purchase_order), method: :post, class: "form-inline" do %>
        <button type="submit" class="btn-success">↑ Send to Zenventory</button>
      <% end %>
    <% end %>
    <% if policy(@purchase_order).edit? %>
      <a href="<%= edit_warehouse_purchase_order_path(@purchase_order) %>">✎ Edit</a>
    <% end %>
    <% if @purchase_order.zenventory_url.present? %>
      <a href="<%= @purchase_order.zenventory_url %>" target="_blank">↗ Zenventory</a>
    <% end %>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <section style="margin-bottom: 1rem;">
      <strong>Details</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Supplier</span>
        <span><%= @purchase_order.supplier_name %></span>
        <% if @purchase_order.supplier_id.present? %>
          <span class="detail-label">Supplier ID</span>
          <span><code><%= @purchase_order.supplier_id %></code></span>
        <% end %>
        <span class="detail-label">Created</span>
        <span><%= @purchase_order.created_at.strftime("%b %d, %Y %H:%M") %></span>
        <span class="detail-label">Created by</span>
        <span><%= @purchase_order.user&.email || "—" %></span>
        <% if @purchase_order.order_number.present? %>
          <span class="detail-label">Order Number</span>
          <span><code><%= @purchase_order.order_number %></code></span>
        <% end %>
        <% if @purchase_order.required_by_date.present? %>
          <span class="detail-label">Required by</span>
          <span><%= @purchase_order.required_by_date.strftime("%b %d, %Y") %></span>
        <% end %>
        <span class="detail-label">Zenventory ID</span>
        <span><code><%= @purchase_order.zenventory_id || "—" %></code></span>
      </div>
      <% if @purchase_order.notes.present? %>
        <hr style="margin-top: 0.5rem;">
        <div style="margin-top: 0.5rem;">
          <span class="detail-label">Notes</span>
          <div style="margin-top: 0.25rem;"><%= simple_format(@purchase_order.notes) %></div>
        </div>
      <% end %>
    </section>

    <section style="margin-bottom: 1rem;">
      <strong>Line Items</strong>
      <hr>
      <table style="width: 100%; margin-top: 0.5rem;">
        <thead>
          <tr>
            <th style="text-align: left;">SKU</th>
            <th style="text-align: right;">Quantity</th>
            <th style="text-align: right;">Unit Cost</th>
            <th style="text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @purchase_order.line_items.each do |li| %>
            <tr>
              <td style="padding: 0.25rem 0.5rem;">
                <a href="<%= warehouse_sku_path(li.sku) %>" style="text-decoration: none;"><%= li.sku.name %></a>
                <span style="color: GrayText;"> (<code><%= li.sku.sku %></code>)</span>
              </td>
              <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= li.quantity %></td>
              <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(li.unit_cost) %></td>
              <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency((li.unit_cost || 0) * li.quantity) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr style="font-weight: bold;">
            <td style="padding: 0.25rem 0.5rem;">Total</td>
            <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= @purchase_order.line_items.sum(&:quantity) %></td>
            <td></td>
            <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(@purchase_order.total_cost) %></td>
          </tr>
        </tfoot>
      </table>
    </section>

    <%= render partial: "admin_inspector", locals: { record: @purchase_order } %>
  </div>

  <div class="show-sidebar">
    <section style="margin-bottom: 1rem;">
      <strong>Actions</strong>
      <hr>
      <div style="margin-top: 0.5rem;">
        <% if policy(@purchase_order).sync? %>
          <%= form_with url: sync_warehouse_purchase_order_path(@purchase_order), method: :post, class: "form-inline" do %>
            <button type="submit" class="btn-sm" style="width: 100%; margin-bottom: 0.5rem;">⟳ Sync from Zenventory</button>
          <% end %>
        <% end %>
        <% if @purchase_order.zenventory_id.present? %>
          <a href="https://app.zenventory.com/printing/printpurchaseorder.php?poid=<%= @purchase_order.zenventory_id %>" target="_blank" style="display: block; margin-bottom: 0.5rem;"><button class="btn-sm" style="width: 100%;">⎘ Download PDF</button></a>
        <% end %>
        <% if policy(@purchase_order).destroy? %>
          <%= form_with url: warehouse_purchase_order_path(@purchase_order), method: :delete, data: { turbo_confirm: "Delete this purchase order?" }, class: "form-inline" do %>
            <button type="submit" class="btn-danger btn-sm" style="width: 100%;">✕ Delete</button>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>
</div>
