<% content_for :title, "Purchase Order #{@purchase_order.order_number.presence || "##{@purchase_order.id}"}" %>

<%
  badge_class = {
    "draft" => "badge",
    "submitted" => "badge badge-info",
    "approved" => "badge badge-success",
    "returned" => "badge badge-warning",
    "open" => "badge badge-info",
    "completed" => "badge badge-success",
    "deleted" => "badge badge-danger"
  }[@purchase_order.status] || "badge"
%>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_purchase_orders_path %>" style="text-decoration: none; color: var(--foreground2);">&larr; Purchase Orders</a>
    <strong style="font-size: 1.15em;"><%= @purchase_order.order_number.presence || "##{@purchase_order.id}" %></strong>
    <span class="<%= badge_class %>"><%= @purchase_order.humanized_state %></span>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <span style="color: var(--foreground2);"><%= @purchase_order.supplier_name %></span>
  </div>
  <span class="spacer"></span>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <%# Draft + owner: Submit for Approval %>
    <% if policy(@purchase_order).submit? && @purchase_order.draft? %>
      <%= button_to "Submit for Approval", submit_for_approval_warehouse_purchase_order_path(@purchase_order), method: :post, class: "btn-success", data: { confirm: "Submit this purchase order for approval?" } %>
    <% end %>

    <%# Returned + owner: Submit for Review again %>
    <% if @purchase_order.returned? && policy(@purchase_order).edit? %>
      <%= button_to "Submit for Approval", submit_for_approval_warehouse_purchase_order_path(@purchase_order), method: :post, class: "btn-success", data: { confirm: "Re-submit this purchase order for approval?" } %>
    <% end %>

    <%# Submitted + czar: Approve / Return for Revision %>
    <% if policy(@purchase_order).approve? %>
      <%= button_to "✓ Approve", approve_warehouse_purchase_order_path(@purchase_order), method: :post, class: "btn-success", data: { confirm: "Approve this purchase order?" } %>
    <% end %>
    <% if policy(@purchase_order).return_for_revision? %>
      <details class="popover">
        <summary tabindex="0" class="btn-warning" style="cursor:pointer;">↩ Return</summary>
        <div style="padding: 0.75rem; min-width: 20rem;">
          <form action="<%= reject_warehouse_purchase_order_path(@purchase_order) %>" method="post">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <div style="margin-bottom: 0.5rem;">
              <label style="display:block;color:var(--foreground2);margin-bottom:0.25rem;">Notes for drafter</label>
              <textarea name="reviewer_notes" rows="3" style="width:100%;" placeholder="What needs to be revised?"></textarea>
            </div>
            <button type="submit" class="btn-warning" onclick="return confirm('Return this purchase order for revision?')">↩ Return for Revision</button>
          </form>
        </div>
      </details>
    <% end %>

    <%# Approved + czar + all SKUs resolved: Send to Zenventory %>
    <% if policy(@purchase_order).send_to_zenventory? && @purchase_order.all_skus_resolved? %>
      <%= button_to "↑ Send to Zenventory", send_to_zenventory_warehouse_purchase_order_path(@purchase_order), method: :post, class: "btn-success" %>
    <% end %>

    <%# Approved but blocked on SKUs: show warning %>
    <% if @purchase_order.blocked_on_skus? %>
      <span class="badge badge-warning">Waiting on <%= @purchase_order.unresolved_sku_requests.count %> SKU request<%= @purchase_order.unresolved_sku_requests.count == 1 ? "" : "s" %></span>
    <% end %>

    <% if policy(@purchase_order).edit? %>
      <a href="<%= edit_warehouse_purchase_order_path(@purchase_order) %>">&#x270E; Edit</a>
    <% end %>
    <% if @purchase_order.zenventory_url.present? %>
      <a href="<%= @purchase_order.zenventory_url %>" target="_blank">&nearr; Zenventory</a>
    <% end %>
  </div>
</div>

<%# Returned banner %>
<% if @purchase_order.returned? %>
  <div class="banner banner-warning" style="margin-bottom: 1rem;">
    <strong>Returned for revision<%= @purchase_order.reviewed_by ? " by #{@purchase_order.reviewed_by.username || @purchase_order.reviewed_by.email}" : "" %>.</strong>
    <% if @purchase_order.reviewer_notes.present? %>
      <div style="margin-top: 0.25rem;"><strong>Notes:</strong> <%= @purchase_order.reviewer_notes %></div>
    <% end %>
  </div>
<% end %>

<div class="show-layout">
  <div class="show-main">
    <section style="margin-bottom: 1rem;">
      <strong>Details</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Supplier</span>
        <span><%= @purchase_order.supplier_name %></span>
        <% if @purchase_order.supplier_id.present? %>
          <span class="detail-label">Supplier ID</span>
          <span><code><%= @purchase_order.supplier_id %></code></span>
        <% end %>
        <span class="detail-label">Created</span>
        <span><%= @purchase_order.created_at.strftime("%b %d, %Y %H:%M") %></span>
        <span class="detail-label">Created by</span>
        <span><%= @purchase_order.user&.email || "—" %></span>
        <% if @purchase_order.order_number.present? %>
          <span class="detail-label">Order Number</span>
          <span><code><%= @purchase_order.order_number %></code></span>
        <% end %>
        <% if @purchase_order.required_by_date.present? %>
          <span class="detail-label">Required by</span>
          <span><%= @purchase_order.required_by_date.strftime("%b %d, %Y") %></span>
        <% end %>
        <% if @purchase_order.reviewed_by.present? %>
          <span class="detail-label">Reviewed by</span>
          <span><%= @purchase_order.reviewed_by.username || @purchase_order.reviewed_by.email %></span>
        <% end %>
        <% if @purchase_order.reviewed_at.present? %>
          <span class="detail-label">Reviewed at</span>
          <span><%= @purchase_order.reviewed_at.strftime("%b %d, %Y %H:%M") %></span>
        <% end %>
        <span class="detail-label">Zenventory ID</span>
        <span><code><%= @purchase_order.zenventory_id || "—" %></code></span>
      </div>
      <% if @purchase_order.notes.present? %>
        <hr style="margin-top: 0.5rem;">
        <div style="margin-top: 0.5rem;">
          <span class="detail-label">Notes</span>
          <div style="margin-top: 0.25rem;"><%= simple_format(@purchase_order.notes) %></div>
        </div>
      <% end %>
    </section>

    <%# Blocking SKU requests section %>
    <% if @purchase_order.blocked_on_skus? || @purchase_order.has_returned_sku_requests? %>
      <section style="margin-bottom: 1rem; border: 1px solid var(--yellow); padding: 0.75rem;">
        <strong style="color: var(--yellow);">&#x26A0; SKU Requests Requiring Attention</strong>
        <% if @purchase_order.has_returned_sku_requests? %>
          <div style="color: var(--red); margin-top: 0.25rem;">Some SKU requests have been returned and need to be revised before this purchase order can proceed.</div>
        <% elsif @purchase_order.blocked_on_skus? %>
          <div style="color: var(--foreground2); margin-top: 0.25rem;">This purchase order is approved but waiting on the following SKU requests before it can be sent to Zenventory.</div>
        <% end %>
        <hr>
        <% @purchase_order.unresolved_sku_requests.each do |req| %>
          <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border-color, #333);">
            <div style="flex: 1;">
              <a href="<%= warehouse_sku_request_path(req) %>" style="text-decoration: none; font-weight: 600;"><%= req.name %></a>
              <% if req.returned? %>
                <span class="badge badge-danger" style="margin-left: 0.25rem;">Returned</span>
              <% else %>
                <span class="badge badge-info" style="margin-left: 0.25rem;"><%= req.aasm_state.humanize %></span>
              <% end %>
              <% if req.suggested_sku_code.present? %>
                <span style="color: var(--foreground2); margin-left: 0.25rem;">suggested: <code><%= req.suggested_sku_code %></code></span>
              <% end %>
            </div>
            <% if current_user.warehouse_czar? && req.aasm_state == "submitted" %>
              <div style="display: flex; align-items: center; gap: 0.25rem;">
                <%= form_with url: approve_warehouse_sku_request_path(req), method: :post, local: true do %>
                  <input type="text" name="assigned_sku_code" placeholder="SKU code" required style="width: 8rem; padding: 0.15rem 0.35rem; font-size: 0.85em;">
                  <button type="submit" class="btn-success btn-sm" onclick="return confirm('Approve this SKU request?')">✓ Approve</button>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section style="margin-bottom: 1rem;">
      <strong>Line Items</strong>
      <hr>
      <table style="width: 100%; margin-top: 0.5rem;">
        <thead>
          <tr>
            <th style="text-align: left;">SKU</th>
            <th style="text-align: right;">Quantity</th>
            <th style="text-align: right;">Unit Cost</th>
            <th style="text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @purchase_order.line_items.includes(:sku, :sku_request).each do |li| %>
            <tr>
              <td style="padding: 0.25rem 0.5rem;">
                <% if li.sku.present? %>
                  <a href="<%= warehouse_sku_path(li.sku) %>" style="text-decoration: none;"><%= li.sku.name %></a>
                  <span style="color: var(--foreground2);"> (<code><%= li.sku.sku %></code>)</span>
                <% elsif li.sku_request.present? %>
                  <a href="<%= warehouse_sku_request_path(li.sku_request) %>" style="text-decoration: none;"><%= li.sku_request.name %></a>
                  <% if li.sku_request.returned? %>
                    <span class="badge badge-danger" style="margin-left: 0.25rem;">returned</span>
                  <% elsif li.sku_request.aasm_state.in?(%w[submitted approved]) %>
                    <span class="badge badge-info" style="margin-left: 0.25rem;">pending</span>
                  <% else %>
                    <span class="badge" style="margin-left: 0.25rem;"><%= li.sku_request.aasm_state %></span>
                  <% end %>
                <% else %>
                  <span style="color: var(--foreground2);">Unknown</span>
                <% end %>
              </td>
              <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= li.quantity %></td>
              <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(li.unit_cost) %></td>
              <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency((li.unit_cost || 0) * li.quantity) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr style="font-weight: bold;">
            <td style="padding: 0.25rem 0.5rem;">Total</td>
            <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= @purchase_order.line_items.sum(&:quantity) %></td>
            <td></td>
            <td style="padding: 0.25rem 0.5rem; text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(@purchase_order.total_cost) %></td>
          </tr>
        </tfoot>
      </table>
    </section>

    <%= render partial: "admin_inspector", locals: { record: @purchase_order } %>
  </div>

  <div class="show-sidebar">
    <section style="margin-bottom: 1rem;">
      <strong>Actions</strong>
      <hr>
      <div style="margin-top: 0.5rem;">
        <% if policy(@purchase_order).sync? %>
          <%= form_with url: sync_warehouse_purchase_order_path(@purchase_order), method: :post, local: true, class: "form-inline" do %>
            <button type="submit" class="btn-sm" style="width: 100%; margin-bottom: 0.5rem;">⟳ Sync from Zenventory</button>
          <% end %>
        <% end %>
        <% if @purchase_order.zenventory_id.present? %>
          <a href="https://app.zenventory.com/printing/printpurchaseorder.php?poid=<%= @purchase_order.zenventory_id %>" target="_blank" style="display: block; margin-bottom: 0.5rem;"><button class="btn-sm" style="width: 100%;">⎘ Download PDF</button></a>
        <% end %>
        <% if policy(@purchase_order).destroy? %>
          <%= button_to "✕ Delete", warehouse_purchase_order_path(@purchase_order), method: :delete, class: "btn-danger btn-sm", form_class: "form-inline", data: { confirm: "Delete this purchase order?" } %>
        <% end %>
      </div>
    </section>
  </div>
</div>
