<%= form_with(model: purchase_order, url: purchase_order.persisted? ? warehouse_purchase_order_path(purchase_order) : warehouse_purchase_orders_path) do |form| %>
  <% if purchase_order.errors.any? %>
    <div box-="square" style="margin-bottom: 1lh; color: var(--red);">
      <strong>[!] <%= pluralize(purchase_order.errors.count, "error") %>:</strong>
      <ul style="margin: 0.25lh 0 0; padding-left: 2ch;">
        <% purchase_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div box-="round" style="margin-bottom: 1lh;">
    <strong>Supplier Information</strong>
    <div is-="separator"></div>
    <div style="margin-top: 0.5lh;">
      <div style="margin-bottom: 0.5lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Supplier name <span style="color: var(--red);">*</span></label>
        <input type="text" name="warehouse_purchase_order[supplier_name]" value="<%= purchase_order.supplier_name %>" required style="width: 100%;">
      </div>
      <div style="margin-bottom: 0.5lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Supplier ID</label>
        <input type="text" name="warehouse_purchase_order[supplier_id]" value="<%= purchase_order.supplier_id %>" style="width: 100%;">
      </div>
      <div style="margin-bottom: 0.5lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Required by date</label>
        <%= form.date_field :required_by_date, style: "width: 100%;" %>
      </div>
      <div style="margin-bottom: 0.5lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Notes</label>
        <textarea name="warehouse_purchase_order[notes]" rows="3" style="width: 100%;"><%= purchase_order.notes %></textarea>
      </div>
    </div>
  </div>

  <div box-="round" style="margin-bottom: 1lh;">
    <strong>Line Items</strong>
    <div is-="separator"></div>
    <div style="margin-top: 0.5lh;">
      <%= render Components::Warehouse::LineItemsEditor.new(
        form: form,
        scope: :enabled,
        show_unit_cost: true,
        add_button_text: "Add Item"
      ) %>
    </div>
  </div>

  <row gap-="1" align-="center">
    <span class="toolbar-spacer"></span>
    <a href="<%= warehouse_purchase_orders_path %>" style="color: var(--foreground2);">Cancel</a>
    <button type="submit" variant-="green">✓ <%= purchase_order.persisted? ? "Update Purchase Order" : "Create Purchase Order" %></button>
  </row>
<% end %>
