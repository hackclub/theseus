<%= form_with(model: purchase_order, url: purchase_order.persisted? ? warehouse_purchase_order_path(purchase_order) : warehouse_purchase_orders_path) do |form| %>
  <% if purchase_order.errors.any? %>
    <div class="mb-1 text-danger">
      <strong>[!] <%= pluralize(purchase_order.errors.count, "error") %>:</strong>
      <ul class="form-error-list">
        <% purchase_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="mb-1">
    <strong>Supplier Information</strong>
    <hr>
    <div class="mt-half">
      <div class="mb-half">
        <label class="text-muted label-block">Supplier name <span class="text-danger">*</span></label>
        <input type="text" name="warehouse_purchase_order[supplier_name]" value="<%= purchase_order.supplier_name %>" required class="w-100">
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Supplier ID</label>
        <input type="text" name="warehouse_purchase_order[supplier_id]" value="<%= purchase_order.supplier_id %>" class="w-100">
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Required by date</label>
        <%= form.date_field :required_by_date, class: "w-100" %>
      </div>
      <div class="mb-half">
        <label class="text-muted label-block">Notes</label>
        <textarea name="warehouse_purchase_order[notes]" rows="3" class="w-100"><%= purchase_order.notes %></textarea>
      </div>
    </div>
  </section>

  <section class="mb-1">
    <strong>Line Items</strong>
    <hr>
    <div class="mt-half">
      <%= render Components::Warehouse::LineItemsEditor.new(
        form: form,
        scope: :enabled,
        show_unit_cost: true,
        allow_pending_skus: true,
        add_button_text: "Add Item"
      ) %>
    </div>
  </section>

  <div class="flex-row">
    <span class="spacer"></span>
    <a href="<%= warehouse_purchase_orders_path %>" class="text-muted">Cancel</a>
    <button type="submit" class="btn-success">✓ <%= purchase_order.persisted? ? "Update Purchase Order" : "Create Purchase Order" %></button>
  </div>
<% end %>
