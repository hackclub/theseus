<%= form_with(model: purchase_order, url: purchase_order.persisted? ? warehouse_purchase_order_path(purchase_order) : warehouse_purchase_orders_path) do |form| %>
  <% if purchase_order.errors.any? %>
    <div style="margin-bottom: 1rem; color: var(--red);">
      <strong>[!] <%= pluralize(purchase_order.errors.count, "error") %>:</strong>
      <ul style="margin: 0.25rem 0 0; padding-left: 1rem;">
        <% purchase_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section style="margin-bottom: 1rem;">
    <strong>Supplier Information</strong>
    <hr>
    <div style="margin-top: 0.5rem;">
      <div style="margin-bottom: 0.5rem;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25rem;">Supplier name <span style="color: var(--red);">*</span></label>
        <input type="text" name="warehouse_purchase_order[supplier_name]" value="<%= purchase_order.supplier_name %>" required style="width: 100%;">
      </div>
      <div style="margin-bottom: 0.5rem;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25rem;">Supplier ID</label>
        <input type="text" name="warehouse_purchase_order[supplier_id]" value="<%= purchase_order.supplier_id %>" style="width: 100%;">
      </div>
      <div style="margin-bottom: 0.5rem;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25rem;">Required by date</label>
        <%= form.date_field :required_by_date, style: "width: 100%;" %>
      </div>
      <div style="margin-bottom: 0.5rem;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25rem;">Notes</label>
        <textarea name="warehouse_purchase_order[notes]" rows="3" style="width: 100%;"><%= purchase_order.notes %></textarea>
      </div>
    </div>
  </section>

  <section style="margin-bottom: 1rem;">
    <strong>Line Items</strong>
    <hr>
    <div style="margin-top: 0.5rem;">
      <%= render Components::Warehouse::LineItemsEditor.new(
        form: form,
        scope: :enabled,
        show_unit_cost: true,
        add_button_text: "Add Item"
      ) %>
    </div>
  </section>

  <div style="display:flex;align-items:center;gap:0.5rem">
    <span class="spacer"></span>
    <a href="<%= warehouse_purchase_orders_path %>" style="color: var(--foreground2);">Cancel</a>
    <button type="submit" class="btn-success">✓ <%= purchase_order.persisted? ? "Update Purchase Order" : "Create Purchase Order" %></button>
  </div>
<% end %>
