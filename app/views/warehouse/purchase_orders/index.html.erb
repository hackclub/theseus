<% content_for :title, "Purchase Orders" %>

<div class="toolbar">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_skus_path %>" style="text-decoration: none; color: GrayText;">← SKUs</a>
    <strong style="font-size: 1.15em;">Purchase Orders</strong>
    <%= render Components::Shared::Jumpcode.new(path: warehouse_purchase_orders_path) %>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <span style="color: GrayText;"><%= @purchase_orders.count %> orders</span>
  </div>
  <span class="spacer"></span>
  <a href="<%= new_warehouse_purchase_order_path %>" class="btn-success btn-sm">+ New Purchase Order</a>
</div>

<% if @purchase_orders.any? %>
  <% grouped = @purchase_orders.group_by(&:status) %>
  <div class="stat-filters" id="stats-container" style="margin-bottom: 1rem;">
    <% if grouped["draft"]&.any? %>
      <button class="stat-filter" data-filter="draft">
        <span class="stat-count"><%= grouped["draft"]&.count || 0 %></span>
        <span class="stat-label">Draft</span>
      </button>
    <% end %>
    <% if grouped["open"]&.any? %>
      <button class="stat-filter" data-filter="open">
        <span class="stat-count"><%= grouped["open"]&.count || 0 %></span>
        <span class="stat-label">Open</span>
      </button>
    <% end %>
    <% if grouped["completed"]&.any? %>
      <button class="stat-filter" data-filter="completed">
        <span class="stat-count"><%= grouped["completed"]&.count || 0 %></span>
        <span class="stat-label">Completed</span>
      </button>
    <% end %>
  </div>

  <section>
    <% @purchase_orders.each_with_index do |po, i|
      badge_class = { "draft" => "badge", "open" => "badge badge-info", "completed" => "badge badge-success", "deleted" => "badge badge-danger" }[po.status] || "badge" %>
      <% if i > 0 %><hr><% end %>
      <div class="po-row" data-status="<%= po.status %>" style="padding: 0.5rem 0;">
        <div style="display:flex;align-items:center;gap:0.5rem">
          <%= link_to po.order_number.presence || "##{po.id}", warehouse_purchase_order_path(po), class: "mono fw-medium" %>
          <span class="<%= badge_class %>"><%= po.humanized_state %></span>
          <span style="color: GrayText;"><%= po.supplier_name %></span>
          <span style="flex: 1;"></span>
          <span class="fw-medium"><%= po.line_items.sum(&:quantity) %> units</span>
          <span style="color: GrayText;"><%= number_to_currency(po.total_cost) %></span>
          <% if po.required_by_date.present? %>
            <span style="color: GrayText;">due <%= po.required_by_date.strftime("%b %d") %></span>
          <% end %>
          <span style="color: GrayText;"><%= time_ago_in_words(po.created_at) %> ago</span>
          <% admin_tool do %>
            <details class="popover">
              <summary tabindex="0" class="btn-sm">⋯</summary>
              <div style="display:flex;flex-direction:column">
                <a href="<%= warehouse_purchase_order_path(po) %>">👁 View</a>
                <% if po.draft? %>
                  <a href="<%= edit_warehouse_purchase_order_path(po) %>">✎ Edit</a>
                <% end %>
                <% if po.zenventory_id.present? %>
                  <a href="<%= po.zenventory_url %>" target="_blank">↗ Zenventory</a>
                  <a href="https://app.zenventory.com/printing/printpurchaseorder.php?poid=<%= po.zenventory_id %>" target="_blank">⎘ Zenv PDF</a>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% else %>
  <section style="text-align: center; padding: 2rem;">
    <strong>No purchase orders yet</strong>
    <div style="color: GrayText; margin-top: 0.5rem;">Create your first purchase order to get started.</div>
    <div style="margin-top: 1rem;"><a href="<%= new_warehouse_purchase_order_path %>">Create Purchase Order</a></div>
  </section>
<% end %>

<script>
(function() {
  let selectedStatus = null;

  function getFilters() { return document.querySelectorAll('.stat-filter'); }
  function getRows() { return document.querySelectorAll('.po-row'); }

  function updateDisplay() {
    getRows().forEach(row => {
      row.style.display = (!selectedStatus || row.dataset.status === selectedStatus) ? '' : 'none';
    });
    getFilters().forEach(f => {
      f.style.outline = (f.dataset.filter === selectedStatus) ? '1px solid currentColor' : 'none';
    });
  }

  document.addEventListener('click', function(e) {
    const filter = e.target.closest('.stat-filter');
    if (filter) {
      selectedStatus = (selectedStatus === filter.dataset.filter) ? null : filter.dataset.filter;
      updateDisplay();
    }
  });
})();
</script>
