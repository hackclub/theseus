<% content_for :title, "Purchase Orders" %>

<div class="toolbar">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= warehouse_skus_path %>" style="text-decoration: none; color: var(--foreground2);">&larr; SKUs</a>
    <strong style="font-size: 1.15em;">Purchase Orders</strong>
    <%= render Components::Shared::Jumpcode.new(path: warehouse_purchase_orders_path) %>
  </div>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <span style="color: var(--foreground2);"><%= @purchase_orders.count %> orders</span>
  </div>
  <span class="spacer"></span>
  <a href="<%= new_warehouse_purchase_order_path %>" class="btn-success btn-sm">+ New Purchase Order</a>
</div>

<% if @purchase_orders.any? %>
  <% grouped = @purchase_orders.group_by(&:status) %>
  <div class="stat-filters" id="stats-container" style="margin-bottom: 1rem;">
    <button class="stat-filter" data-filter="all">
      <span class="stat-count"><%= @purchase_orders.count %></span>
      <span class="stat-label">All</span>
    </button>
    <% if grouped["draft"]&.any? %>
      <button class="stat-filter" data-filter="draft">
        <span class="stat-count"><%= grouped["draft"].count %></span>
        <span class="stat-label">Draft</span>
      </button>
    <% end %>
    <% if grouped["submitted"]&.any? %>
      <button class="stat-filter" data-filter="submitted">
        <span class="stat-count"><%= grouped["submitted"].count %></span>
        <span class="stat-label">Pending Approval</span>
      </button>
    <% end %>
    <% if grouped["approved"]&.any? %>
      <button class="stat-filter" data-filter="approved">
        <span class="stat-count"><%= grouped["approved"].count %></span>
        <span class="stat-label">Approved</span>
      </button>
    <% end %>
    <% if grouped["open"]&.any? %>
      <button class="stat-filter" data-filter="open">
        <span class="stat-count"><%= grouped["open"].count %></span>
        <span class="stat-label">Sent</span>
      </button>
    <% end %>
    <% if grouped["completed"]&.any? %>
      <button class="stat-filter" data-filter="completed">
        <span class="stat-count"><%= grouped["completed"].count %></span>
        <span class="stat-label">Completed</span>
      </button>
    <% end %>
    <% if grouped["returned"]&.any? %>
      <button class="stat-filter" data-filter="returned">
        <span class="stat-count"><%= grouped["returned"].count %></span>
        <span class="stat-label">Returned</span>
      </button>
    <% end %>
  </div>

  <%
    badge_classes = {
      "draft" => "badge",
      "submitted" => "badge badge-info",
      "approved" => "badge badge-success",
      "returned" => "badge badge-warning",
      "open" => "badge badge-info",
      "completed" => "badge badge-success",
      "deleted" => "badge badge-danger"
    }
  %>

  <section>
    <% @purchase_orders.each_with_index do |po, i| %>
      <% if i > 0 %><hr><% end %>
      <div class="po-row" data-status="<%= po.status %>" style="padding: 0.5rem 0;">
        <div style="display:flex;align-items:center;gap:0.5rem">
          <%= link_to po.order_number.presence || "##{po.id}", warehouse_purchase_order_path(po), class: "mono fw-medium" %>
          <span class="<%= badge_classes[po.status] || "badge" %>"><%= po.humanized_state %></span>
          <span style="color: var(--foreground2);"><%= po.supplier_name %></span>
          <span style="flex: 1;"></span>
          <span class="fw-medium"><%= po.line_items.sum(&:quantity) %> units</span>
          <span style="color: var(--foreground2);"><%= number_to_currency(po.total_cost) %></span>
          <% if po.required_by_date.present? %>
            <span style="color: var(--foreground2);">due <%= po.required_by_date.strftime("%b %d") %></span>
          <% end %>
          <span style="color: var(--foreground2);"><%= time_ago_in_words(po.created_at) %> ago</span>
          <% admin_tool do %>
            <details class="popover">
              <summary tabindex="0" class="btn-sm">&ctdot;</summary>
              <div style="display:flex;flex-direction:column">
                <a href="<%= warehouse_purchase_order_path(po) %>">&nbsp;&#x1F441; View</a>
                <% if po.draft? || po.returned? %>
                  <a href="<%= edit_warehouse_purchase_order_path(po) %>">&#x270E; Edit</a>
                <% end %>
                <% if po.zenventory_id.present? %>
                  <a href="<%= po.zenventory_url %>" target="_blank">&nearr; Zenventory</a>
                  <a href="https://app.zenventory.com/printing/printpurchaseorder.php?poid=<%= po.zenventory_id %>" target="_blank">&#x2398; Zenv PDF</a>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% else %>
  <section style="text-align: center; padding: 2rem;">
    <strong>No purchase orders yet</strong>
    <div style="color: var(--foreground2); margin-top: 0.5rem;">Create your first purchase order to get started.</div>
    <div style="margin-top: 1rem;"><a href="<%= new_warehouse_purchase_order_path %>">Create Purchase Order</a></div>
  </section>
<% end %>

<script>
(function() {
  let selectedStatus = null;

  function getFilters() { return document.querySelectorAll('.stat-filter'); }
  function getRows() { return document.querySelectorAll('.po-row'); }

  function updateDisplay() {
    getRows().forEach(row => {
      row.style.display = (!selectedStatus || selectedStatus === 'all' || row.dataset.status === selectedStatus) ? '' : 'none';
    });
    // Also hide <hr> separators between hidden rows
    document.querySelectorAll('section hr').forEach(hr => {
      const prev = hr.previousElementSibling;
      const next = hr.nextElementSibling;
      if (prev && prev.classList.contains('po-row') && next && next.classList.contains('po-row')) {
        hr.style.display = (prev.style.display === 'none' || next.style.display === 'none') ? 'none' : '';
      }
    });
    getFilters().forEach(f => {
      f.style.outline = (f.dataset.filter === selectedStatus) ? '1px solid currentColor' : 'none';
    });
  }

  document.addEventListener('click', function(e) {
    const filter = e.target.closest('.stat-filter');
    if (filter) {
      const val = filter.dataset.filter;
      selectedStatus = (val === 'all' || selectedStatus === val) ? null : val;
      updateDisplay();
    }
  });
})();
</script>
