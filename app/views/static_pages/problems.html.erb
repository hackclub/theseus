<% content_for :title, "Problems" %>

<div class="toolbar">
  <strong class="text-title">Problems</strong>
  <%= render Components::Shared::Jumpcode.new(path: problems_path) %>
  <span class="spacer"></span>
</div>

<% if @blocking.empty? && @no_po_cost.empty? && @backordered.empty? && @stuck_orders.empty? %>
  <div class="empty-state">
    <div class="batch-processed-icon text-success">✓</div>
    <strong>No problems!</strong>
    <p class="text-muted hint-tight">Go take a nap or something.</p>
  </div>
<% end %>

<% if @blocking.any? %>
  <section class="mb-1">
    <div class="flex-row">
      <strong>Dispatch Blockers</strong>
      <span class="badge badge-danger">blocking</span>
    </div>
    <p class="text-muted hint-tight">No cost data at all — orders with these SKUs will refuse to dispatch.</p>
    <hr>
    <table class="mt-half">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>In Stock</th>
          <th>Zenventory</th>
        </tr>
      </thead>
      <tbody>
        <% @blocking.each do |sku| %>
          <tr>
            <td><a href="<%= warehouse_sku_path(sku) %>" class="no-underline"><code><%= sku.sku %></code></a></td>
            <td><%= sku.name %></td>
            <td><%= sku.in_stock || "—" %></td>
            <td>
              <% if sku.zenventory_url %>
                <a href="<%= sku.zenventory_url %>" target="_blank">view ↗</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% if @no_po_cost.any? %>
  <section class="mb-1">
    <div class="flex-row">
      <strong>Missing PO Cost Data</strong>
      <span class="badge badge-warning">degraded</span>
    </div>
    <p class="text-muted hint-tight">No <code>average_po_cost</code> from Zenventory — covered by fallback but should be fixed.</p>
    <hr>
    <table class="mt-half">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>Cost</th>
          <th>Source</th>
          <th>Zenventory</th>
        </tr>
      </thead>
      <tbody>
        <% @no_po_cost.each do |sku| %>
          <tr>
            <td><a href="<%= warehouse_sku_path(sku) %>" class="no-underline"><code><%= sku.sku %></code></a></td>
            <td><%= sku.name %></td>
            <td><%= number_to_currency(sku.declared_unit_cost) %></td>
            <td class="text-muted"><%= sku.declared_unit_cost_override&.positive? ? "override" : "???" %></td>
            <td>
              <% if sku.zenventory_url %>
                <a href="<%= sku.zenventory_url %>" target="_blank">view ↗</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% if @backordered.any? %>
  <section class="mb-1">
    <div class="flex-row">
      <strong>Backordered Without Enough Inbound</strong>
      <span class="badge badge-warning">warning</span>
    </div>
    <p class="text-muted hint-tight">Oversold and not enough inbound stock to cover the deficit.</p>
    <hr>
    <table class="mt-half">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>In Stock</th>
          <th>Inbound</th>
          <th>Shortfall</th>
        </tr>
      </thead>
      <tbody>
        <% @backordered.each do |sku| %>
          <tr>
            <td><a href="<%= warehouse_sku_path(sku) %>" class="no-underline"><code><%= sku.sku %></code></a></td>
            <td><%= sku.name %></td>
            <td class="fw-600 text-danger"><%= sku.in_stock %></td>
            <td><%= sku.inbound || 0 %></td>
            <td class="fw-600 text-danger"><%= sku.in_stock.abs - (sku.inbound || 0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% if @stuck_orders.any? %>
  <section class="mb-1">
    <div class="flex-row">
      <strong>Stuck Orders</strong>
      <span class="badge badge-danger">blocking</span>
    </div>
    <p class="text-muted hint-tight">Dispatched 2+ weeks ago, never marked mailed. Possible Zenventory sync issue.</p>
    <hr>
    <table class="mt-half">
      <thead>
        <tr>
          <th>Order</th>
          <th>Recipient</th>
          <th>Dispatched</th>
          <th>Age</th>
          <th>Zenventory</th>
        </tr>
      </thead>
      <tbody>
        <% @stuck_orders.each do |order| %>
          <tr>
            <td><a href="<%= warehouse_order_path(order) %>" class="no-underline"><code><%= order.hc_id %></code></a></td>
            <td><%= order.recipient_email %></td>
            <td class="text-muted"><%= order.dispatched_at.strftime("%b %d") %></td>
            <td class="text-danger"><%= distance_of_time_in_words_to_now(order.dispatched_at) %></td>
            <td>
              <% if order.zenventory_url %>
                <a href="<%= order.zenventory_url %>" target="_blank">view ↗</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
