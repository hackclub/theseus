<% content_for :title, "Problems" %>

<div class="page-toolbar">
  <strong style="font-size: 1.15em;">Problems</strong>
  <%= render Components::Shared::Jumpcode.new(path: problems_path) %>
  <span class="toolbar-spacer"></span>
</div>

<% if @blocking.empty? && @no_po_cost.empty? && @backordered.empty? && @stuck_orders.empty? %>
  <div box-="round" style="text-align: center; padding: 2lh 2ch;">
    <div style="font-size: 2em; color: var(--green);">✓</div>
    <strong>No problems!</strong>
    <p style="color: var(--foreground2); margin: 0.25lh 0 0;">Go take a nap or something.</p>
  </div>
<% end %>

<% if @blocking.any? %>
  <div box-="round" style="margin-bottom: 1lh;">
    <row gap-="1" align-="center">
      <strong>Dispatch Blockers</strong>
      <span is-="badge" variant-="red">blocking</span>
    </row>
    <p style="color: var(--foreground2); margin: 0.25lh 0 0;">No cost data at all — orders with these SKUs will refuse to dispatch.</p>
    <div is-="separator"></div>
    <table style="margin-top: 0.5lh;">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>In Stock</th>
          <th>Zenventory</th>
        </tr>
      </thead>
      <tbody>
        <% @blocking.each do |sku| %>
          <tr>
            <td><a href="<%= warehouse_sku_path(sku) %>" style="text-decoration: none; color: var(--foreground0);"><code><%= sku.sku %></code></a></td>
            <td><%= sku.name %></td>
            <td><%= sku.in_stock || "—" %></td>
            <td>
              <% if sku.zenventory_url %>
                <a href="<%= sku.zenventory_url %>" target="_blank">view ↗</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @no_po_cost.any? %>
  <div box-="round" style="margin-bottom: 1lh;">
    <row gap-="1" align-="center">
      <strong>Missing PO Cost Data</strong>
      <span is-="badge" variant-="yellow">degraded</span>
    </row>
    <p style="color: var(--foreground2); margin: 0.25lh 0 0;">No <code>average_po_cost</code> from Zenventory — covered by fallback but should be fixed.</p>
    <div is-="separator"></div>
    <table style="margin-top: 0.5lh;">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>Cost</th>
          <th>Source</th>
          <th>Zenventory</th>
        </tr>
      </thead>
      <tbody>
        <% @no_po_cost.each do |sku| %>
          <tr>
            <td><a href="<%= warehouse_sku_path(sku) %>" style="text-decoration: none; color: var(--foreground0);"><code><%= sku.sku %></code></a></td>
            <td><%= sku.name %></td>
            <td><%= number_to_currency(sku.declared_unit_cost) %></td>
            <td style="color: var(--foreground2);"><%= sku.declared_unit_cost_override&.positive? ? "override" : "???" %></td>
            <td>
              <% if sku.zenventory_url %>
                <a href="<%= sku.zenventory_url %>" target="_blank">view ↗</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @backordered.any? %>
  <div box-="round" style="margin-bottom: 1lh;">
    <row gap-="1" align-="center">
      <strong>Backordered Without Enough Inbound</strong>
      <span is-="badge" variant-="yellow">warning</span>
    </row>
    <p style="color: var(--foreground2); margin: 0.25lh 0 0;">Oversold and not enough inbound stock to cover the deficit.</p>
    <div is-="separator"></div>
    <table style="margin-top: 0.5lh;">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>In Stock</th>
          <th>Inbound</th>
          <th>Shortfall</th>
        </tr>
      </thead>
      <tbody>
        <% @backordered.each do |sku| %>
          <tr>
            <td><a href="<%= warehouse_sku_path(sku) %>" style="text-decoration: none; color: var(--foreground0);"><code><%= sku.sku %></code></a></td>
            <td><%= sku.name %></td>
            <td style="color: var(--red); font-weight: 600;"><%= sku.in_stock %></td>
            <td><%= sku.inbound || 0 %></td>
            <td style="color: var(--red); font-weight: 600;"><%= sku.in_stock.abs - (sku.inbound || 0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @stuck_orders.any? %>
  <div box-="round" style="margin-bottom: 1lh;">
    <row gap-="1" align-="center">
      <strong>Stuck Orders</strong>
      <span is-="badge" variant-="red">blocking</span>
    </row>
    <p style="color: var(--foreground2); margin: 0.25lh 0 0;">Dispatched 2+ weeks ago, never marked mailed. Possible Zenventory sync issue.</p>
    <div is-="separator"></div>
    <table style="margin-top: 0.5lh;">
      <thead>
        <tr>
          <th>Order</th>
          <th>Recipient</th>
          <th>Dispatched</th>
          <th>Age</th>
          <th>Zenventory</th>
        </tr>
      </thead>
      <tbody>
        <% @stuck_orders.each do |order| %>
          <tr>
            <td><a href="<%= warehouse_order_path(order) %>" style="text-decoration: none; color: var(--foreground0);"><code><%= order.hc_id %></code></a></td>
            <td><%= order.recipient_email %></td>
            <td style="color: var(--foreground2);"><%= order.dispatched_at.strftime("%b %d") %></td>
            <td style="color: var(--red);"><%= distance_of_time_in_words_to_now(order.dispatched_at) %></td>
            <td>
              <% if order.zenventory_url %>
                <a href="<%= order.zenventory_url %>" target="_blank">view ↗</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
