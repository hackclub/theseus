<% content_for :title, "#{@payment_account.organization_name} - HCB" %>

<div class="page-toolbar">
  <row gap-="1" align-="center">
    <a href="<%= hcb_payment_accounts_path %>" style="text-decoration: none; color: var(--foreground2);">← HCB Accounts</a>
    <strong style="font-size: 1.15em;"><%= @payment_account.organization_name %></strong>
  </row>
</div>

<div class="show-layout">
  <div class="show-main">
    <div box-="round">
      <strong style="display: block; padding: 0.5lh 1ch;">Organization Details</strong>
      <div is-="separator"></div>
      <div class="detail-grid" style="padding: 0.5lh 1ch;">
        <span class="detail-label">Organization</span>
        <span><%= @payment_account.organization_name %></span>
        <span class="detail-label">Organization ID</span>
        <code><%= @payment_account.organization_id %></code>
        <span class="detail-label">Added</span>
        <span><%= @payment_account.created_at.strftime("%B %d, %Y") %></span>
      </div>
    </div>
  </div>

  <div class="show-sidebar">
  </div>
</div>
