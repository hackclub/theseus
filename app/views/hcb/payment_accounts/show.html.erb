<% content_for :title, "#{@payment_account.organization_name} — Billing Profile" %>

<div class="toolbar mb-0" style="border-bottom: none">
  <div class="flex-row">
    <a href="<%= hcb_payment_accounts_path %>" class="text-muted" style="text-decoration: none;">← Billing Profiles</a>
    <strong style="font-size: 1.15em;"><%= @payment_account.organization_name %></strong>
  </div>
  <span class="spacer"></span>
  <%= form_with url: hcb_payment_account_path(@payment_account), method: :delete, data: { turbo_confirm: "Remove this organization?" }, class: "form-inline" do %>
    <button type="submit" class="btn-danger btn-sm">✕ Remove</button>
  <% end %>
</div>

<div class="show-layout">
  <div class="show-main">
    <section class="mb-1">
      <strong>Organization Details</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">Billing Profile ID</span>
        <span><%= copy_to_clipboard(@payment_account.public_id) { content_tag(:code, @payment_account.public_id) } %></span>
        <span class="detail-label">Organization</span>
        <span><%= @payment_account.organization_name %></span>
        <span class="detail-label">HCB Org ID</span>
        <span><code><%= @payment_account.organization_id %></code></span>
        <span class="detail-label">Added</span>
        <span><%= @payment_account.created_at.strftime("%b %d, %Y") %></span>
      </div>
    </section>
  </div>

  <div class="show-sidebar">
  </div>
</div>
