<% content_for :title, "Add HCB Organization" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= hcb_payment_accounts_path %>" class="text-muted" style="text-decoration: none;">← HCB Accounts</a>
    <strong style="font-size: 1.15em;">Add Organization</strong>
  </div>
</div>

<% if @organizations.any? %>
  <%= form_with url: hcb_payment_accounts_path, method: :post do |f| %>
    <section style="margin-bottom: 1rem;">
      <strong>Select Organization</strong>
      <hr>
      <div style="margin-top: 0.5rem; color: var(--foreground2);">Choose which HCB organization to use for paying postage.</div>
      <% @organizations.each do |org| %>
        <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0; border-bottom: 1px solid var(--background2); cursor: pointer;">
          <%= f.radio_button :organization_id, org.id %>
          <span style="font-weight: 500;"><%= org.name %></span>
        </label>
      <% end %>
    </section>

    <div style="display:flex;align-items:center;gap:0.5rem;justify-content: flex-end;">
      <a href="<%= hcb_payment_accounts_path %>" class="text-muted" style="text-decoration: none;">Cancel</a>
      <button type="submit" class="btn-success">Add Organization</button>
    </div>
  <% end %>
<% else %>
  <section style="text-align: center; padding: 2rem;">
    <strong>No organizations available</strong>
    <div class="text-muted" style="margin-top: 0.25rem;">You don't belong to any HCB organizations, or all your organizations are already linked.</div>
    <div style="margin-top: 1rem;"><a href="<%= hcb_payment_accounts_path %>" class="text-muted">← Back</a></div>
  </section>
<% end %>
