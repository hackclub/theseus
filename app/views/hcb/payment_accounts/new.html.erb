<% content_for :title, "Add HCB Organization" %>

<div class="toolbar mb-0 no-border-bottom">
  <div class="flex-row">
    <a href="<%= hcb_payment_accounts_path %>" class="text-muted no-underline">← HCB Accounts</a>
    <strong class="text-title">Add Organization</strong>
  </div>
</div>

<% if @organizations.any? %>
  <%= form_with url: hcb_payment_accounts_path, method: :post do |f| %>
    <section class="mb-1">
      <strong>Select Organization</strong>
      <hr>
      <div class="mt-half text-muted">Choose which HCB organization to use for paying postage.</div>
      <% @organizations.each do |org| %>
        <label class="pointer org-picker-row">
          <%= f.radio_button :organization_id, org.id %>
          <span class="fw-medium"><%= org.name %></span>
        </label>
      <% end %>
    </section>

    <div class="form-actions-end">
      <a href="<%= hcb_payment_accounts_path %>" class="text-muted no-underline">Cancel</a>
      <button type="submit" class="btn-success">Add Organization</button>
    </div>
  <% end %>
<% else %>
  <section class="empty-state">
    <strong>No organizations available</strong>
    <div class="text-muted mt-quarter">You don't belong to any HCB organizations, or all your organizations are already linked.</div>
    <div class="mt-1"><a href="<%= hcb_payment_accounts_path %>" class="text-muted">← Back</a></div>
  </section>
<% end %>
