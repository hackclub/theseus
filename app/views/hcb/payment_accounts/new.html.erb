<% content_for :title, "Add HCB Organization" %>

<div class="page-container--xs">
  <h1 class="page-title content-section">Add Organization</h1>

  <% if @organizations.any? %>
    <div class="content-section">
      <h2 class="section-heading">Select Organization</h2>
      <p class="page-subtitle mb-3">Choose which HCB organization to use for paying postage.</p>

      <%= form_with url: hcb_payment_accounts_path, method: :post do |f| %>
        <div box-="round" style="margin-bottom: 2lh;">
          <% @organizations.each do |org| %>
            <label class="radio-label-row" style="display: block; padding: 0.5lh 1ch; border-bottom: 1px solid var(--background2);">
              <%= f.radio_button :organization_id, org.id, class: "accent-radio" %>
              <span class="fw-medium"><%= org.name %></span>
            </label>
          <% end %>
        </div>

        <div class="page-actions">
          <a href="<%= hcb_payment_accounts_path %>">Cancel</a>
          <button type="submit" variant-="green">✓ Add Organization</button>
        </div>
      <% end %>
    </div>
  <% else %>
    <div box-="round" style="text-align: center; padding: 2lh 2ch;">
      <h3 style="margin: 0;">No organizations available</h3>
      <p style="color: var(--foreground2);">You don't belong to any HCB organizations, or all your organizations are already linked.</p>
      <a href="<%= hcb_payment_accounts_path %>">Back</a>
    </div>
  <% end %>

  <div class="back-link">
    <a href="<%= hcb_payment_accounts_path %>">← Back to HCB accounts</a>
  </div>
</div>
