<% content_for :title, "HCB Payment Accounts" %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title">HCB Payment Accounts</h1>
    <% if current_user.hcb_connected? %>
      <a href="<%= new_hcb_payment_account_path %>" variant-="green">+ Add Organization</a>
    <% end %>
  </div>

  <% if current_user.hcb_connected? %>
    <div class="two-col-layout">
      <div>
        <h2 class="section-heading">Your Organizations</h2>
        <% if @payment_accounts.any? %>
          <div box-="round">
            <% @payment_accounts.each do |account| %>
              <a href="<%= hcb_payment_account_path(account) %>" class="resource-card link-reset" style="display: block; padding: 0.5lh 1ch; border-bottom: 1px solid var(--background2);">
                <div class="resource-card-info">
                  <span class="resource-card-title"><%= account.organization_name %></span>
                  <span class="resource-card-meta">Added <%= time_ago_in_words(account.created_at) %> ago</span>
                </div>
                <span style="color: var(--foreground2);">→</span>
              </a>
            <% end %>
          </div>
        <% else %>
          <div box-="round" style="text-align: center; padding: 2lh 2ch;">
            <h3 style="margin: 0;">No organizations linked yet</h3>
            <p style="color: var(--foreground2);">Add one to start paying for postage.</p>
            <a href="<%= new_hcb_payment_account_path %>">Add Organization</a>
          </div>
        <% end %>
      </div>

      <div>
        <h2 class="section-heading">Account Status</h2>
        <div box-="round">
          <div style="padding: 1lh 1ch;">
            <div class="status-row">
              <span style="color: var(--green);">✓</span>
              <span class="fw-semibold" style="color: var(--green);">HCB Connected</span>
            </div>
            <p class="kv-label" style="margin: 0;">
              Your account is linked to HCB. You can pay for postage using any of your organizations' funds.
            </p>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="page-container--center">
      <div box-="round" style="text-align: center; padding: 2lh 2ch;">
        <h2 style="margin: 0;">🔗 Connect to HCB</h2>
        <p style="color: var(--foreground2);">Link your HCB account to pay for postage directly from your organization's funds.</p>
        <a href="<%= new_hcb_oauth_connection_path %>" variant-="green">Connect HCB Account</a>
      </div>
    </div>
  <% end %>
</div>
