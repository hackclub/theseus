<% content_for :title, "HCB Payment Accounts" %>

<div class="page-toolbar">
  <row gap-="1" align-="center">
    <strong style="font-size: 1.15em;">HCB Payment Accounts</strong>
  </row>
  <span class="toolbar-spacer"></span>
  <% if current_user.hcb_connected? %>
    <a href="<%= new_hcb_payment_account_path %>"><button variant-="green">+ Add Organization</button></a>
  <% end %>
</div>

<% if current_user.hcb_connected? %>
  <div class="show-layout">
    <div class="show-main">
      <% if @payment_accounts.any? %>
        <table>
          <thead>
            <tr>
              <th>Organization</th>
              <th>Added</th>
            </tr>
          </thead>
          <tbody>
            <% @payment_accounts.each do |account| %>
              <tr>
                <td><a href="<%= hcb_payment_account_path(account) %>" style="text-decoration: none;"><strong><%= account.organization_name %></strong></a></td>
                <td style="color: var(--foreground2);"><%= account.created_at.strftime("%b %d, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div box-="round" style="text-align: center; padding: 2lh 2ch;">
          <strong>No organizations linked yet</strong>
          <div style="color: var(--foreground2); margin-top: 0.25lh;">Add one to start paying for postage.</div>
        </div>
      <% end %>
    </div>

    <div class="show-sidebar">
      <div box-="round" style="margin-bottom: 1lh;">
        <strong>Account Status</strong>
        <div is-="separator"></div>
        <div style="margin-top: 0.5lh;">
          <row gap-="1" align-="center">
            <span style="color: var(--green);">✓</span>
            <span style="font-weight: 500; color: var(--green);">HCB Connected</span>
          </row>
          <div style="color: var(--foreground2); margin-top: 0.5lh;">
            Your account is linked to HCB. You can pay for postage using any of your organizations' funds.
          </div>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div box-="round" style="text-align: center; padding: 2lh 2ch; max-width: 60ch; margin: 2lh auto;">
    <strong style="font-size: 1.15em;">🔗 Connect to HCB</strong>
    <div style="color: var(--foreground2); margin-top: 0.5lh; margin-bottom: 1lh;">Link your HCB account to pay for postage directly from your organization's funds.</div>
    <a href="<%= new_hcb_oauth_connection_path %>"><button variant-="green">Connect HCB Account</button></a>
  </div>
<% end %>
