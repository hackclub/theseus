<% content_for :title, "HCB Payment Accounts" %>

<div class="toolbar">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <strong style="font-size: 1.15em;">HCB Payment Accounts</strong>
  </div>
  <span class="spacer"></span>
  <% if current_user.hcb_connected? %>
    <a href="<%= new_hcb_payment_account_path %>"><button class="btn-success">+ Add Organization</button></a>
  <% end %>
</div>

<% if current_user.hcb_connected? %>
  <div class="show-layout">
    <div class="show-main">
      <% if @payment_accounts.any? %>
        <table>
          <thead>
            <tr>
              <th>Organization</th>
              <th>Added</th>
            </tr>
          </thead>
          <tbody>
            <% @payment_accounts.each do |account| %>
              <tr>
                <td><a href="<%= hcb_payment_account_path(account) %>" style="text-decoration: none;"><strong><%= account.organization_name %></strong></a></td>
                <td class="text-muted"><%= account.created_at.strftime("%b %d, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <section style="text-align: center; padding: 2rem;">
          <strong>No organizations linked yet</strong>
          <div class="text-muted" style="margin-top: 0.25rem;">Add one to start paying for postage.</div>
        </section>
      <% end %>
    </div>

    <div class="show-sidebar">
      <section style="margin-bottom: 1rem;">
        <strong>Account Status</strong>
        <hr>
        <div style="margin-top: 0.5rem;">
          <div style="display:flex;align-items:center;gap:0.5rem">
            <span style="color: var(--green);">✓</span>
            <span style="font-weight: 500; color: var(--green);">HCB Connected</span>
          </div>
          <div class="text-muted" style="margin-top: 0.5rem;">
            Your account is linked to HCB. You can pay for postage using any of your organizations' funds.
          </div>
        </div>
      </section>
    </div>
  </div>
<% else %>
  <section style="text-align: center; padding: 2rem; max-width: 30rem; margin: 2rem auto;">
    <strong style="font-size: 1.15em;">🔗 Connect to HCB</strong>
    <div class="text-muted" style="margin-top: 0.5rem; margin-bottom: 1rem;">Link your HCB account to pay for postage directly from your organization's funds.</div>
    <a href="<%= new_hcb_oauth_connection_path %>"><button class="btn-success">Connect HCB Account</button></a>
  </section>
<% end %>
