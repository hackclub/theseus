<% content_for :title, "Billing Profiles" %>

<div class="toolbar">
  <div class="flex-row">
    <strong class="text-title">Billing Profiles</strong>
  </div>
  <span class="spacer"></span>
  <% if current_user.hcb_connected? %>
    <a href="<%= new_hcb_payment_account_path %>"><button class="btn-success">+ Add Organization</button></a>
  <% end %>
</div>

<% if current_user.hcb_connected? %>
  <div class="show-layout">
    <div class="show-main">
      <% if @payment_accounts.any? %>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Organization</th>
              <th>Added</th>
            </tr>
          </thead>
          <tbody>
            <% @payment_accounts.each do |account| %>
              <tr>
                <td><code class="text-sm"><%= account.public_id %></code></td>
                <td><a href="<%= hcb_payment_account_path(account) %>" class="no-underline"><strong><%= account.organization_name %></strong></a></td>
                <td class="text-muted"><%= account.created_at.strftime("%b %d, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <section class="empty-state">
          <strong>No organizations linked yet</strong>
          <div class="text-muted mt-quarter">Add one to start paying for postage.</div>
        </section>
      <% end %>
    </div>

    <div class="show-sidebar">
      <section class="mb-1">
        <strong>Account Status</strong>
        <hr>
        <div class="mt-half">
          <div class="flex-row">
            <span class="text-success">✓</span>
            <span class="fw-medium text-success">HCB Connected</span>
          </div>
          <div class="text-muted mt-half">
            Your account is linked to HCB. You can pay for postage using any of your organizations' funds.
          </div>
        </div>
      </section>
    </div>
  </div>
<% else %>
  <section class="hcb-connect-card">
    <strong class="text-title">🔗 Connect to HCB</strong>
    <div class="text-muted mt-half mb-1">Link your HCB account to pay for postage directly from your organization's funds.</div>
    <a href="<%= new_hcb_oauth_connection_path %>"><button class="btn-success">Connect HCB Account</button></a>
  </section>
<% end %>
