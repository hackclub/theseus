<tr id="<%= dom_id letter %>">
  <td class="cell-pad">
    <a href="<%= letter_path(letter) %>" class="link-bold"><%= letter.public_id %></a>
    <% if letter.user_facing_title.present? %>
      <span class="row-tag"><%= letter.user_facing_title %></span>
    <% end %>
  </td>
  <td class="cell-pad"><%= letter.created_at.strftime(letter.created_at.year == Date.current.year ? "%b %d" : "%b %d, %Y") %></td>
  <td class="cell-pad"><%= letter.address&.name_line || "—" %></td>
  <td class="text-muted cell-pad"><%= letter.origin_label %></td>
  <td class="cell-pad">
    <%= render Components::Shared::StatusBadge.new(status: letter.aasm_state, type: :letter) %>
  </td>
</tr>
