<tr id="<%= dom_id letter %>">
  <td style="padding: 0.25lh 1ch;">
    <a href="<%= letter_path(letter) %>" style="font-weight: bold; text-decoration: none;"><%= letter.public_id %></a>
    <% if letter.user_facing_title.present? %>
      <span class="row-tag"><%= letter.user_facing_title %></span>
    <% end %>
  </td>
  <td style="padding: 0.25lh 1ch;"><%= letter.created_at.strftime(letter.created_at.year == Date.current.year ? "%b %d" : "%b %d, %Y") %></td>
  <td style="padding: 0.25lh 1ch;"><%= letter.address&.name_line || "—" %></td>
  <td style="padding: 0.25lh 1ch; color: var(--foreground2);"><%= letter.origin_label %></td>
  <td style="padding: 0.25lh 1ch;">
    <%= render Components::Shared::StatusBadge.new(status: letter.aasm_state, type: :letter) %>
  </td>
</tr>
