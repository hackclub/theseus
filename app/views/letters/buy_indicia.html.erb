<% content_for :title, "Buy Indicia — #{@letter.public_id}" %>

<div class="toolbar mb-0 no-border-bottom">
  <div class="flex-row">
    <a href="<%= letter_path(@letter) %>" class="text-muted no-underline">← <%= @letter.public_id %></a>
    <strong class="text-title">Buy Indicia</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <section class="mb-1">
      <strong>Letter Details</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">Recipient</span>
        <span><%= @letter.address.name_line %></span>
        <span class="detail-label">Destination</span>
        <span><%= @letter.address.city %>, <%= @letter.address.state %></span>
        <span class="detail-label">Dimensions</span>
        <span><%= @letter.height %> × <%= @letter.width %> in, <%= @letter.weight %> oz</span>
      </div>
      <% if @letter.non_machinable? %>
        <hr class="mt-half">
        <div class="mt-half">
          <span class="badge badge-warning">⚠ Non-machinable surcharge applies</span>
        </div>
      <% end %>
    </section>

    <section class="mb-1">
      <strong>Purchase Postage</strong>
      <hr>
      <div class="mt-half">
        <%= form_with(url: buy_indicia_letter_path(@letter), method: :post) do |form| %>
          <div class="mb-half">
            <label class="text-muted label-block">USPS Payment Account</label>
            <select name="usps_payment_account_id" required class="w-100">
              <option value="">Select account…</option>
              <% USPS::PaymentAccount.all.each do |account| %>
                <option value="<%= account.id %>" <%= "selected" if account.id == USPS::PaymentAccount.first&.id %>><%= account.name %></option>
              <% end %>
            </select>
          </div>

          <%= render Components::MoneyNotice.new(
            lines: @letter.billing_lines,
            profiles: current_user.billing_profiles,
            field: "hcb_payment_account_id",
            proceed: "Buy Indicia",
            cancel_href: letter_path(@letter),
          ) %>
        <% end %>
      </div>
    </section>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>Info</strong>
      <hr>
      <div class="mt-half text-muted">
        Purchasing indicia buys USPS postage for this letter. The estimate above is charged to the selected HCB organization before the purchase; if USPS sells us nothing, it is refunded.
      </div>
    </section>
  </div>
</div>
