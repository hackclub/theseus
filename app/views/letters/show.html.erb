<% content_for :title, "#{@letter.user_facing_title || 'Letter'} #{@letter.public_id}" %>

<div style="display:flex;align-items:baseline;gap:0.75rem;margin-bottom:1rem;">
  <a href="<%= letters_path %>" style="text-decoration:none;color:var(--foreground2);font-size:0.85em;">← Letters</a>
  <h2 style="margin:0;font-size:1.25em;">
    <%= @letter.user_facing_title.presence || @letter.address&.name_line || "Letter" %>
  </h2>
  <code style="color:var(--foreground2);font-size:0.85em;"><%= @letter.public_id %></code>
  <span style="font-family:monospace;color:<%= status_color(@letter.aasm_state) %>;">[<%= @letter.aasm_state %>]</span>
  <% @letter.tags.compact_blank.each do |tag| %>
    <a href="<%= tag_stats_path(tag) %>" style="text-decoration:none;font-size:0.85em;color:var(--foreground2);">#<%= tag %></a>
  <% end %>
</div>

<div class="show-layout">
  <div class="show-main">

    <%# ── Addresses ── %>
    <div style="display:flex;gap:1.5rem;margin-bottom:1.5rem;">
      <div style="flex:1;">
        <span style="color:var(--foreground2);font-size:0.75em;text-transform:uppercase;letter-spacing:0.05em;">From</span>
        <div style="font-family:monospace;font-size:0.9em;line-height:1.6;margin-top:0.25rem;">
          <% if @letter.return_address.present? %>
            <strong><%= @letter.return_address_name_line %></strong><br>
            <%= @letter.return_address.line_1 %><br>
            <% if @letter.return_address.line_2.present? %><%= @letter.return_address.line_2 %><br><% end %>
            <%= @letter.return_address.city %>, <%= @letter.return_address.state %> <%= @letter.return_address.postal_code %>
          <% else %>
            <span style="color:var(--foreground2);">—</span>
          <% end %>
        </div>
      </div>
      <div style="flex:1;">
        <span style="color:var(--foreground2);font-size:0.75em;text-transform:uppercase;letter-spacing:0.05em;">To</span>
        <div style="font-family:monospace;font-size:0.9em;line-height:1.6;margin-top:0.25rem;">
          <strong><%= @letter.address.name_line %></strong><br>
          <%= @letter.address.line_1 %><br>
          <% if @letter.address.line_2.present? %><%= @letter.address.line_2 %><br><% end %>
          <%= @letter.address.city %>, <%= @letter.address.state %> <%= @letter.address.postal_code %>
        </div>
      </div>
    </div>

    <hr>

    <%# ── Specs ── %>
    <div class="detail-grid" style="margin:1rem 0;">
      <span class="detail-label">Size</span>
      <code><%= @letter.height %> × <%= @letter.width %> in, <%= @letter.weight %> oz</code>

      <span class="detail-label">Category</span>
      <code><%= @letter.processing_category %><%= " · non-machinable" if @letter.non_machinable %></code>

      <span class="detail-label">Mailing date</span>
      <code><%= @letter.mailing_date&.strftime("%Y-%m-%d") || "—" %></code>

      <span class="detail-label">Created</span>
      <span><%= @letter.created_at.strftime("%b %-d, %Y %H:%M") %> · <%= @letter.created_via || "manual" %></span>

      <% if @letter.batch.present? %>
        <span class="detail-label">Batch</span>
        <span><a href="<%= letter_batch_path(@letter.batch) %>"><%= @letter.batch.user_facing_title || @letter.batch.public_id %></a></span>
      <% end %>

      <% if @letter.recipient_email.present? %>
        <span class="detail-label">Email</span>
        <span><%= @letter.recipient_email %></span>
      <% end %>
    </div>

    <hr>

    <%# ── Postage ── %>
    <div style="margin:1rem 0;">
      <% if @letter.postage_type == "indicia" && @letter.usps_indicium.present? %>
        <div style="display:flex;align-items:baseline;gap:0.5rem;">
          <code style="color:var(--green);">[✓]</code>
          <strong style="font-size:1.1em;font-variant-numeric:tabular-nums;"><%= number_to_currency(@letter.usps_indicium.cost) %></strong>
          <span class="text-muted" style="font-size:0.85em;">indicia</span>
        </div>
        <div class="detail-grid" style="margin-top:0.5rem;font-size:0.85em;">
          <span class="detail-label">Tracking</span>
          <code><%= @letter.usps_indicium.tracking_number || "—" %></code>
          <span class="detail-label">USPS SKU</span>
          <code><%= @letter.usps_indicium.usps_sku %></code>
          <span class="detail-label">Indicium</span>
          <code><%= @letter.usps_indicium.public_id %></code>
        </div>
        <%= render 'admin_inspector', record: @letter.usps_indicium %>
      <% elsif @letter.postage_type == "indicia" %>
        <div style="display:flex;align-items:baseline;gap:0.5rem;">
          <code style="color:var(--yellow);">[!]</code>
          <span>indicia not purchased</span>
          <span class="text-muted" style="font-size:0.85em;">est. <%= number_to_currency(@letter.postage) %></span>
        </div>
        <% if @letter.batch_id.nil? %>
          <div style="margin-top:0.75rem;">
            <%= render 'buy_indicia_form', letter: @letter %>
          </div>
        <% end %>
      <% elsif @letter.postage_type == "stamps" %>
        <div style="display:flex;align-items:baseline;gap:0.5rem;">
          <code style="color:var(--foreground2);">[ ]</code>
          <span>stamps</span>
          <span class="text-muted" style="font-size:0.85em;"><%= number_to_currency(@letter.postage) %></span>
        </div>
      <% else %>
        <code style="color:var(--foreground2);">[ ] no postage</code>
      <% end %>

      <% if @letter.rubber_stamps.present? %>
        <div style="margin-top:0.5rem;" class="text-muted">
          Rubber stamps: <%= @letter.rubber_stamps %>
        </div>
      <% end %>
    </div>

    <%# ── Timeline ── %>
    <% if @letter.printed_at || @letter.mailed_at || @letter.received_at %>
      <hr>
      <div style="margin:1rem 0;font-size:0.9em;">
        <% if @letter.printed_at %>
          <div><span style="font-family:monospace;color:var(--green);">[✓]</span> Printed <span class="text-muted"><%= @letter.printed_at.strftime("%b %-d, %Y %H:%M") %></span></div>
        <% end %>
        <% if @letter.mailed_at %>
          <div><span style="font-family:monospace;color:var(--green);">[✓]</span> Mailed <span class="text-muted"><%= @letter.mailed_at.strftime("%b %-d, %Y %H:%M") %></span></div>
        <% end %>
        <% if @letter.received_at %>
          <div><span style="font-family:monospace;color:var(--green);">[✓]</span> Received <span class="text-muted"><%= @letter.received_at.strftime("%b %-d, %Y %H:%M") %></span></div>
        <% end %>
      </div>
    <% end %>

    <% if @letter.label.attached? %>
      <hr>
      <a href="<%= rails_blob_path(@letter.label, disposition: :inline) %>" target="_blank">⬇ Label PDF</a>
    <% end %>

    <%= render 'admin_inspector', record: @letter %>
  </div>

  <%# ── Sidebar ── %>
  <div class="show-sidebar">
    <%# Preview ── %>
    <% if @letter.label.attached? %>
      <div style="margin-bottom:1rem;border:1px solid var(--background2);border-radius:4px;overflow:hidden;">
        <iframe src="<%= rails_blob_path(@letter.label, disposition: :inline) %>" style="width:100%;height:18rem;border:none;"></iframe>
      </div>
      <%= render 'shared/instant_print_window', url: rails_blob_path(@letter.label, disposition: 'inline') %>
    <% end %>

    <div style="display:flex;flex-direction:column;gap:0.5rem;font-size:0.9em;">
      <%# Primary action — the NEXT thing to do %>
      <% if @letter.pending? && @letter.label.attached? %>
        <%= form_with url: mark_printed_letter_path(@letter), method: :post, class: "form-inline" do %>
          <button type="submit" class="btn-success" style="width:100%;">Mark Printed</button>
        <% end %>
      <% elsif @letter.printed? %>
        <%= form_with url: mark_mailed_letter_path(@letter), method: :post, class: "form-inline" do %>
          <button type="submit" class="btn-success" style="width:100%;">Mark Mailed</button>
        <% end %>
      <% elsif @letter.mailed? %>
        <%= form_with url: mark_received_letter_path(@letter), method: :post, class: "form-inline" do %>
          <button type="submit" class="btn-success" style="width:100%;">Mark Received</button>
        <% end %>
      <% elsif @letter.pending? && !@letter.label.attached? && @letter.batch_id.nil? %>
        <%= form_with(url: generate_label_letter_path(@letter), method: :post) do |f| %>
          <%= render Components::Shared::TemplatePicker.new(form: f, name: :template) %>
          <button type="submit" class="btn-success" style="width:100%;margin-top:0.25rem;">Generate Label</button>
        <% end %>
      <% end %>

      <hr style="margin:0.25rem 0;">

      <%# Secondary actions %>
      <a href="<%= edit_letter_path(@letter) %>" style="text-decoration:none;color:inherit;padding:0.2rem 0;">✎ Edit</a>
      <a href="<%= public_letter_path(@letter) %>" target="_blank" style="text-decoration:none;color:var(--foreground2);padding:0.2rem 0;">Public page ↗</a>
      <% if @letter.label.attached? %>
        <a href="<%= rails_blob_path(@letter.label, disposition: 'attachment') %>" style="text-decoration:none;color:inherit;padding:0.2rem 0;">⬇ Download label</a>
        <a href="<%= preview_template_letter_path(@letter) %>" style="text-decoration:none;color:var(--foreground2);padding:0.2rem 0;">Preview template</a>
      <% end %>

      <%# Destructive actions %>
      <% if @letter.pending? && @letter.usps_indicium.nil? && @letter.batch_id.nil? %>
        <hr style="margin:0.25rem 0;">
        <%= form_with url: letter_path(@letter), method: :delete, class: "form-inline" do %>
          <button type="submit" class="btn-sm" style="width:100%;color:var(--red);border-color:var(--red);" data-turbo-confirm="Delete this letter?">Delete</button>
        <% end %>
      <% end %>
      <% admin_tool do %>
        <% if @letter.label.attached? %>
          <%= form_with url: clear_label_letter_path(@letter), method: :post, class: "form-inline" do %>
            <button type="submit" class="btn-sm" style="width:100%;" data-turbo-confirm="Clear label?">Clear label</button>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
