<% content_for :title, "#{@letter.user_facing_title || 'Letter'} #{@letter.public_id}" %>

<div class="mb-1 letter-header">
  <a href="<%= letters_path %>" class="text-muted no-underline text-sm">← Letters</a>
  <h2 class="text-lg m-0">
    <%= @letter.user_facing_title.presence || @letter.address&.name_line || "Letter" %>
  </h2>
  <code class="text-muted text-sm"><%= @letter.public_id %></code>
  <span style="font-family:monospace;color:<%= status_color(@letter.aasm_state) %>;">[<%= @letter.aasm_state %>]</span>
  <% @letter.tags.compact_blank.each do |tag| %>
    <a href="<%= tag_stats_path(tag) %>" class="text-muted no-underline text-sm">#<%= tag %></a>
  <% end %>
</div>

<div class="show-layout">
  <div class="show-main">

    <%# ── Addresses ── %>
    <div class="mb-1h letter-addr-grid">
      <div class="flex-1">
        <span class="text-muted letter-addr-label">From</span>
        <div class="letter-addr-block">
          <% if @letter.return_address.present? %>
            <strong><%= @letter.return_address_name_line %></strong><br>
            <%= @letter.return_address.line_1 %><br>
            <% if @letter.return_address.line_2.present? %><%= @letter.return_address.line_2 %><br><% end %>
            <%= @letter.return_address.city %>, <%= @letter.return_address.state %> <%= @letter.return_address.postal_code %>
          <% else %>
            <span class="text-muted">—</span>
          <% end %>
        </div>
      </div>
      <div class="flex-1">
        <span class="text-muted letter-addr-label">To</span>
        <div class="letter-addr-block">
          <strong><%= @letter.address.name_line %></strong><br>
          <%= @letter.address.line_1 %><br>
          <% if @letter.address.line_2.present? %><%= @letter.address.line_2 %><br><% end %>
          <%= @letter.address.city %>, <%= @letter.address.state %> <%= @letter.address.postal_code %>
        </div>
      </div>
    </div>

    <hr>

    <%# ── Specs ── %>
    <div class="detail-grid letter-section">
      <span class="detail-label">Size</span>
      <code><%= @letter.height %> × <%= @letter.width %> in, <%= @letter.weight %> oz</code>

      <span class="detail-label">Category</span>
      <code><%= @letter.processing_category %><%= " · non-machinable" if @letter.non_machinable %></code>

      <span class="detail-label">Mailing date</span>
      <code><%= @letter.mailing_date&.strftime("%Y-%m-%d") || "—" %></code>

      <span class="detail-label">Created</span>
      <span><%= @letter.created_at.strftime("%b %-d, %Y %H:%M") %> · <%= @letter.created_via || "manual" %></span>

      <% if @letter.batch.present? %>
        <span class="detail-label">Batch</span>
        <span><a href="<%= letter_batch_path(@letter.batch) %>"><%= @letter.batch.user_facing_title || @letter.batch.public_id %></a></span>
      <% end %>

      <% if @letter.recipient_email.present? %>
        <span class="detail-label">Email</span>
        <span><%= @letter.recipient_email %></span>
      <% end %>
    </div>

    <hr>

    <%# ── Postage ── %>
    <div class="letter-section">
      <% if @letter.postage_type == "indicia" && @letter.usps_indicium.present? %>
        <div class="letter-postage-row">
          <code class="text-success">[✓]</code>
          <strong class="letter-postage-amount"><%= number_to_currency(@letter.usps_indicium.cost) %></strong>
          <span class="text-muted text-sm">indicia</span>
        </div>
        <div class="detail-grid mt-half text-sm">
          <span class="detail-label">Tracking</span>
          <code><%= @letter.usps_indicium.tracking_number || "—" %></code>
          <span class="detail-label">USPS SKU</span>
          <code><%= @letter.usps_indicium.usps_sku %></code>
          <span class="detail-label">Indicium</span>
          <code><%= @letter.usps_indicium.public_id %></code>
        </div>
        <%= render 'admin_inspector', record: @letter.usps_indicium %>
      <% elsif @letter.postage_type == "indicia" %>
        <div class="letter-postage-row">
          <code class="text-warning">[!]</code>
          <span>indicia not purchased</span>
          <span class="text-muted text-sm">est. <%= number_to_currency(@letter.postage) %></span>
        </div>
        <% if @letter.batch_id.nil? %>
          <div class="mt-three-quarter">
            <%= render 'buy_indicia_form', letter: @letter %>
          </div>
        <% end %>
      <% elsif @letter.postage_type == "stamps" %>
        <div class="letter-postage-row">
          <code class="text-muted">[ ]</code>
          <span>stamps</span>
          <span class="text-muted text-sm"><%= number_to_currency(@letter.postage) %></span>
        </div>
      <% else %>
        <code class="text-muted">[ ] no postage</code>
      <% end %>

      <% if @letter.rubber_stamps.present? %>
        <div class="mt-half text-muted">
          Rubber stamps: <%= @letter.rubber_stamps %>
        </div>
      <% end %>
    </div>

    <%# ── Timeline ── %>
    <% if @letter.printed_at || @letter.mailed_at || @letter.received_at %>
      <hr>
      <div class="letter-timeline">
        <% if @letter.printed_at %>
          <div><span class="mono-status text-success">[✓]</span> Printed <span class="text-muted"><%= @letter.printed_at.strftime("%b %-d, %Y %H:%M") %></span></div>
        <% end %>
        <% if @letter.mailed_at %>
          <div><span class="mono-status text-success">[✓]</span> Mailed <span class="text-muted"><%= @letter.mailed_at.strftime("%b %-d, %Y %H:%M") %></span></div>
        <% end %>
        <% if @letter.received_at %>
          <div><span class="mono-status text-success">[✓]</span> Received <span class="text-muted"><%= @letter.received_at.strftime("%b %-d, %Y %H:%M") %></span></div>
        <% end %>
      </div>
    <% end %>

    <% if @letter.label.attached? %>
      <hr>
      <a href="<%= rails_blob_path(@letter.label, disposition: :inline) %>" target="_blank">⬇ Label PDF</a>
    <% end %>

    <%= render 'admin_inspector', record: @letter %>
  </div>

  <%# ── Sidebar ── %>
  <div class="show-sidebar">
    <%# Preview ── %>
    <% if @letter.label.attached? %>
      <div class="mb-1 letter-preview-frame">
        <iframe src="<%= rails_blob_path(@letter.label, disposition: :inline) %>" class="w-100 letter-preview-iframe"></iframe>
      </div>
      <%= render 'shared/instant_print_window', url: rails_blob_path(@letter.label, disposition: 'inline') %>
    <% end %>

    <div class="letter-sidebar-actions">
      <%# Primary action — the NEXT thing to do %>
      <% if @letter.pending? && @letter.label.attached? %>
        <%= form_with url: mark_printed_letter_path(@letter), method: :post, class: "form-inline" do %>
          <button type="submit" class="btn-success w-100">Mark Printed</button>
        <% end %>
      <% elsif @letter.printed? %>
        <%= form_with url: mark_mailed_letter_path(@letter), method: :post, class: "form-inline" do %>
          <button type="submit" class="btn-success w-100">Mark Mailed</button>
        <% end %>
      <% elsif @letter.mailed? %>
        <%= form_with url: mark_received_letter_path(@letter), method: :post, class: "form-inline" do %>
          <button type="submit" class="btn-success w-100">Mark Received</button>
        <% end %>
      <% elsif @letter.pending? && !@letter.label.attached? && @letter.batch_id.nil? %>
        <%= form_with(url: generate_label_letter_path(@letter), method: :post) do |f| %>
          <%= render Components::Shared::TemplatePicker.new(form: f, name: :template) %>
          <button type="submit" class="btn-success w-100 mt-quarter">Generate Label</button>
        <% end %>
      <% end %>

      <hr class="letter-hr-tight">

      <%# Secondary actions %>
      <a href="<%= edit_letter_path(@letter) %>" class="link-inherit letter-action-link">✎ Edit</a>
      <a href="<%= public_letter_path(@letter) %>" target="_blank" class="text-muted letter-action-link">Public page ↗</a>
      <% if @letter.label.attached? %>
        <a href="<%= rails_blob_path(@letter.label, disposition: 'attachment') %>" class="link-inherit letter-action-link">⬇ Download label</a>
        <a href="<%= preview_template_letter_path(@letter) %>" class="text-muted letter-action-link">Preview template</a>
      <% end %>

      <%# Destructive actions %>
      <% if @letter.pending? && @letter.usps_indicium.nil? && @letter.batch_id.nil? %>
        <hr class="letter-hr-tight">
        <%= form_with url: letter_path(@letter), method: :delete, class: "form-inline" do %>
          <button type="submit" class="btn-sm w-100 text-danger letter-delete-btn" data-turbo-confirm="Delete this letter?">Delete</button>
        <% end %>
      <% end %>
      <% admin_tool do %>
        <% if @letter.label.attached? %>
          <%= form_with url: clear_label_letter_path(@letter), method: :post, class: "form-inline" do %>
            <button type="submit" class="btn-sm w-100" data-turbo-confirm="Clear label?">Clear label</button>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
