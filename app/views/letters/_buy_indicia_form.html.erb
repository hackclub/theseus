<%= form_with(url: buy_indicia_letter_path(letter), method: :post) do |form| %>
  <% if current_user.billing_profiles.any? %>
    <div class="mb-half">
      <label class="text-muted" style="display: block; margin-bottom: 0.25rem">HCB Organization</label>
      <select name="hcb_payment_account_id" required class="w-100">
        <option value="">Select organization…</option>
        <% current_user.billing_profiles.each do |account| %>
          <option value="<%= account.id %>"><%= account.organization_name %></option>
        <% end %>
      </select>
    </div>

    <div class="mb-half">
      <label class="text-muted" style="display: block; margin-bottom: 0.25rem">USPS Account</label>
      <select name="usps_payment_account_id" required class="w-100">
        <% USPS::PaymentAccount.all.each do |account| %>
          <option value="<%= account.id %>" <%= "selected" if account.id == USPS::PaymentAccount.first&.id %>><%= account.name %></option>
        <% end %>
      </select>
    </div>

    <button type="submit" class="btn-success w-100">✓ Buy Indicia</button>
  <% else %>
    <span class="text-muted"><%= link_to "Connect your HCB account", new_hcb_oauth_connection_path %> to purchase postage.</span>
  <% end %>
<% end %>
