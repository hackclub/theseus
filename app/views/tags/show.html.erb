<% content_for :title, "Tag: #{@tag}" %>

<div class="page-toolbar">
  <row gap-="1" align-="center">
    <a href="<%= tags_path %>" style="text-decoration: none; color: var(--foreground2);">← Tags</a>
    <strong style="font-size: 1.15em;"><%= @tag %></strong>
    <span is-="badge" variant-="blue">Tag</span>
  </row>
  <span class="toolbar-spacer"></span>
  <row gap-="1" align-="center">
    <select name="time_period" id="time_period" style="margin: 0;">
      <option value="all_time" <%= "selected" if @time_period == "all_time" %>>All-time</option>
      <option value="ytd" <%= "selected" if @time_period == "ytd" %>>Year-to-date</option>
      <option value="month" <%= "selected" if @time_period == "month" %>>Specific month</option>
      <option value="last_week" <%= "selected" if @time_period == "last_week" %>>Last week</option>
      <option value="last_month" <%= "selected" if @time_period == "last_month" %>>Last month</option>
      <option value="last_year" <%= "selected" if @time_period == "last_year" %>>Last year</option>
    </select>
    <span id="year_selector" style="display: <%= @time_period.in?(%w[ytd month]) ? 'inline' : 'none' %>">
      <select name="year" id="year">
        <% @years.each do |y| %>
          <option value="<%= y %>" <%= "selected" if y == @year %>><%= y %></option>
        <% end %>
      </select>
    </span>
    <span id="month_selector" style="display: <%= @time_period == 'month' ? 'inline' : 'none' %>">
      <select name="month" id="month">
        <% @months.each do |name, num| %>
          <option value="<%= num %>" <%= "selected" if num == @month %>><%= name %></option>
        <% end %>
      </select>
    </span>
    <button size-="small" onclick="updateTimePeriod()">Go</button>
  </row>
</div>

<div class="show-layout">
  <div class="show-main">
    <!-- Stats -->
    <row gap-="2" style="margin-bottom: 1lh;">
      <div box-="round" style="flex: 1; text-align: center; padding: 1lh 1ch;">
        <div style="font-size: 1.5em; font-weight: bold;"><%= @warehouse_order_count %></div>
        <div style="color: var(--foreground2);">Warehouse Orders</div>
      </div>
      <div box-="round" style="flex: 1; text-align: center; padding: 1lh 1ch;">
        <div style="font-size: 1.5em; font-weight: bold;"><%= @letter_count %></div>
        <div style="color: var(--foreground2);">Letters</div>
      </div>
    </row>

    <!-- Costs side by side -->
    <row gap-="2" style="margin-bottom: 1lh;">
      <div box-="round" style="flex: 1;">
        <strong>Letter Costs</strong>
        <div is-="separator"></div>
        <div class="detail-grid" style="margin-top: 0.5lh;">
          <span class="detail-label">Postage</span>
          <span style="font-weight: 600;"><%= number_to_currency(@letter_postage_cost) %></span>
        </div>
      </div>

      <div box-="round" style="flex: 1;">
        <strong>Warehouse Costs</strong>
        <div is-="separator"></div>
        <div class="detail-grid" style="margin-top: 0.5lh;">
          <span class="detail-label">Postage</span>
          <span><%= number_to_currency(@warehouse_order_postage_cost) %></span>
          <span class="detail-label">Labor</span>
          <span><%= number_to_currency(@warehouse_order_labor_cost) %></span>
          <span class="detail-label">Contents</span>
          <span><%= number_to_currency(@warehouse_order_contents_cost) %></span>
          <span class="detail-label" style="font-weight: 600;">Total</span>
          <span style="font-weight: 600;"><%= number_to_currency(@warehouse_order_total_cost) %></span>
        </div>
      </div>
    </row>
  </div>

  <div class="show-sidebar">
    <div box-="round">
      <strong>Tag Info</strong>
      <div is-="separator"></div>
      <div class="detail-grid" style="margin-top: 0.5lh;">
        <span class="detail-label">Tag</span>
        <span is-="badge" variant-="blue"><%= @tag %></span>
      </div>
    </div>
  </div>
</div>

<script>
  function updateTimePeriod() {
    const timePeriod = document.getElementById('time_period').value;
    const year = document.getElementById('year').value;
    const month = document.getElementById('month').value;

    document.getElementById('year_selector').style.display =
      timePeriod === 'ytd' || timePeriod === 'month' ? 'inline' : 'none';
    document.getElementById('month_selector').style.display =
      timePeriod === 'month' ? 'inline' : 'none';

    let url = '<%= tag_stats_path(@tag) %>?time_period=' + timePeriod;
    if (timePeriod === 'ytd' || timePeriod === 'month') url += '&year=' + year;
    if (timePeriod === 'month') url += '&month=' + month;

    window.location.href = url;
  }

  document.getElementById('time_period').addEventListener('change', function() {
    const timePeriod = this.value;
    document.getElementById('year_selector').style.display =
      timePeriod === 'ytd' || timePeriod === 'month' ? 'inline' : 'none';
    document.getElementById('month_selector').style.display =
      timePeriod === 'month' ? 'inline' : 'none';
  });
</script>
