<% content_for :title, "Tags" %>

<div class="toolbar">
  <strong style="font-size: 1.15em;">Tags</strong>
  <%= render Components::Shared::Jumpcode.new(path: tags_path) %>
  <span class="spacer"></span>
  <%= form_with url: refresh_tags_path, method: :post, class: "form-inline" do %>
    <button type="submit" class="btn-sm">↻ Refresh</button>
  <% end %>
</div>

<div class="banner" style="margin-bottom: 1rem;">
  This page is cached for performance. Hit refresh if you need fresh data.
</div>

<section style="margin-bottom: 1rem;">
  <strong>Common Tags</strong>
  <hr>
  <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem 0.5rem;">
    <% @common_tags.each do |tag| %>
      <a href="<%= tag_stats_path(tag.tag) %>" style="text-decoration: none;"><span class="badge badge-info"><%= tag.tag %></span></a>
    <% end %>
  </div>
</section>

<section>
  <strong>All Tags</strong>
  <hr>
  <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem 0.5rem;">
    <% @tags.each do |tag| %>
      <a href="<%= tag_stats_path(tag) %>" style="text-decoration: none;"><span class="badge"><%= tag %></span></a>
    <% end %>
  </div>
</section>
