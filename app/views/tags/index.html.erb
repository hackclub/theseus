<% content_for :title, "Tags" %>

<div class="page-container">
  <div class="page-header">
    <div>
      <div class="page-title-group">
        <h1 class="page-title">Tags</h1>
        <%= render Components::Shared::Jumpcode.new(path: tags_path) %>
      </div>
      <p class="page-subtitle">Cost tracking and reporting by tag</p>
    </div>
    <%= form_with url: refresh_tags_path, method: :post, class: "form-inline" do %>
      <button type="submit">↻ Refresh</button>
    <% end %>
  </div>

  <div box-="square" class="tui-banner" style="margin-bottom: 1lh;">
    This page is cached for performance. Hit refresh if you need fresh data.
  </div>

  <div class="content-section">
    <h2 class="section-heading">Common Tags</h2>
    <div class="tags-row">
      <% @common_tags.each do |tag| %>
        <a href="<%= tag_stats_path(tag.tag) %>"><span is-="badge" variant-="blue"><%= tag.tag %></span></a>
      <% end %>
    </div>
  </div>

  <div>
    <h2 class="section-heading">All Tags</h2>
    <div class="tags-row">
      <% @tags.each do |tag| %>
        <a href="<%= tag_stats_path(tag) %>"><span is-="badge" variant-="background2"><%= tag %></span></a>
      <% end %>
    </div>
  </div>
</div>
