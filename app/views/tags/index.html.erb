<% content_for :title, "Tags" %>

<div class="toolbar">
  <strong class="text-title">Tags</strong>
  <%= render Components::Shared::Jumpcode.new(path: tags_path) %>
  <span class="spacer"></span>
  <%= form_with url: refresh_tags_path, method: :post, class: "form-inline" do %>
    <button type="submit" class="btn-sm">↻ Refresh</button>
  <% end %>
</div>

<div class="banner mb-1">
  This page is cached for performance. Hit refresh if you need fresh data.
</div>

<section class="mb-1">
  <strong>Common Tags</strong>
  <hr>
  <div class="mt-half tag-flex-wrap">
    <% @common_tags.each do |tag| %>
      <a href="<%= tag_stats_path(tag.tag) %>" class="no-underline"><span class="badge badge-info"><%= tag.tag %></span></a>
    <% end %>
  </div>
</section>

<section>
  <strong>All Tags</strong>
  <hr>
  <div class="mt-half tag-flex-wrap">
    <% @tags.each do |tag| %>
      <a href="<%= tag_stats_path(tag) %>" class="no-underline"><span class="badge"><%= tag %></span></a>
    <% end %>
  </div>
</section>
