<!DOCTYPE html>
<html>
  <head>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'app_style.scss' %>
  </head>
  <body style="margin: 0 !important;">
    <% if @count && @count > 0 %>
      <%= link_to tasks_path, target: "_top" do %>
        <span class="badge badge-info"><%= @count %></span>
      <% end %>
    <% end %>
  </body>
</html>
