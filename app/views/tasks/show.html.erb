<% content_for :title, "Tasks" %>

<div class="toolbar">
  <strong style="font-size: 1.15em;">Your Tasks</strong>
  <%= render Components::Shared::Jumpcode.new(path: tasks_path) %>
  <span class="spacer"></span>
  <%= form_with url: refresh_tasks_path, method: :post, class: "form-inline" do %>
    <button type="submit" class="btn-sm">⟳ Refresh</button>
  <% end %>
</div>

<% if @tasks.empty? %>
  <section style="text-align: center; padding: 2rem;">
    <div style="font-size: 2em; color: var(--green);">✓</div>
    <strong>All clear!</strong>
    <p class="text-muted" style="margin: 0.25rem 0 0;">No tasks right now.</p>
  </section>
<% else %>
  <% @tasks.group_by { |task| task[:type] }.each do |type, tasks| %>
    <section style="margin-bottom: 1rem;">
      <strong><%= type %></strong>
      <hr>
      <% tasks.each_with_index do |task, i| %>
        <% if i > 0 %><hr><% end %>
        <div style="padding: 0.5rem 0;">
          <div style="display:flex;align-items:center;gap:0.5rem">
            <div style="flex: 1;">
              <span style="font-weight: 500;"><%= task[:name] %></span>
              <% if task[:subtitle] %>
                <span class="text-muted">(<%= task[:subtitle] %>)</span>
              <% end %>
            </div>
            <a href="<%= task[:link] %>"><button class="btn-sm">Go →</button></a>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>
<% end %>
