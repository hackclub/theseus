<% content_for :title, "Source Tags" %>

<div class="toolbar">
  <strong style="font-size: 1.15em;">Source Tags</strong>
  <span class="text-muted"><%= @source_tags.count %> tags</span>
  <span class="spacer"></span>
  <a href="<%= new_source_tag_path %>"><button class="btn-success btn-sm">+ New</button></a>
</div>

<% if @source_tags.any? %>
  <table>
    <thead>
      <tr>
        <th>Slug</th>
        <th>Name</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <% @source_tags.each do |source_tag| %>
        <tr>
          <td><a href="<%= source_tag_path(source_tag) %>" style="text-decoration: none; font-weight: bold;"><code><%= source_tag.slug %></code></a></td>
          <td><%= source_tag.name %></td>
          <td class="text-muted"><%= source_tag.owner.presence || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <section style="text-align: center; padding: 2rem;">
    <p style="margin: 0 0 0.5rem;">No source tags yet.</p>
    <a href="<%= new_source_tag_path %>"><button class="btn-success">+ Create Source Tag</button></a>
  </section>
<% end %>
