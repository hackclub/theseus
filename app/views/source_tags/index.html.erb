<% content_for :title, "Source Tags" %>

<div class="page-toolbar">
  <strong style="font-size: 1.15em;">Source Tags</strong>
  <span style="color: var(--foreground2);"><%= @source_tags.count %> tags</span>
  <span class="toolbar-spacer"></span>
  <a href="<%= new_source_tag_path %>"><button variant-="green" size-="small">+ New</button></a>
</div>

<% if @source_tags.any? %>
  <table>
    <thead>
      <tr>
        <th>Slug</th>
        <th>Name</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <% @source_tags.each do |source_tag| %>
        <tr>
          <td><a href="<%= source_tag_path(source_tag) %>" style="text-decoration: none; color: var(--foreground0); font-weight: bold;"><code><%= source_tag.slug %></code></a></td>
          <td><%= source_tag.name %></td>
          <td style="color: var(--foreground2);"><%= source_tag.owner.presence || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div box-="round" style="text-align: center; padding: 2lh 2ch;">
    <p style="margin: 0 0 0.5lh;">No source tags yet.</p>
    <a href="<%= new_source_tag_path %>"><button variant-="green">+ Create Source Tag</button></a>
  </div>
<% end %>
