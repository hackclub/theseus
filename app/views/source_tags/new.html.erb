<% content_for :title, "New Source Tag" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= source_tags_path %>" class="text-muted" style="text-decoration: none;">← Source Tags</a>
    <strong style="font-size: 1.15em;">New Source Tag</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", source_tag: @source_tag %>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>About Source Tags</strong>
      <hr>
      <div style="margin-top: 0.5rem; color: GrayText;">
        <p style="margin: 0;">Source tags identify where mail originates from. Use a short slug for programmatic access.</p>
      </div>
    </section>
  </div>
</div>
