<% content_for :title, "Edit #{@source_tag.name}" %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= source_tag_path(@source_tag) %>" class="text-muted" style="text-decoration: none;">← <%= @source_tag.name %></a>
    <strong style="font-size: 1.15em;">Edit Source Tag</strong>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <%= render "form", source_tag: @source_tag %>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>Current Values</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Slug</span>
        <code><%= @source_tag.slug %></code>
        <span class="detail-label">Name</span>
        <span><%= @source_tag.name %></span>
        <span class="detail-label">Owner</span>
        <span><%= @source_tag.owner.presence || "—" %></span>
      </div>
    </section>
  </div>
</div>
