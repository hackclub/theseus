<% content_for :title, @source_tag.name %>

<div class="page-container">
  <div class="page-header">
    <div>
      <div class="page-title-group">
        <h1 class="page-title"><%= @source_tag.name %></h1>
      </div>
      <code class="kv-label"><%= @source_tag.slug %></code>
    </div>
    <div class="page-actions">
      <a href="<%= edit_source_tag_path(@source_tag) %>"><button size-="small">✎ Edit</button></a>
    </div>
  </div>

  <div box-="round" style="margin-bottom: 2lh;">
    <div class="kv-row" style="padding: 0.5lh 1ch;"><span class="kv-label">Slug</span><code><%= @source_tag.slug %></code></div>
    <div is-="separator"></div>
    <div class="kv-row" style="padding: 0.5lh 1ch;"><span class="kv-label">Name</span><span><%= @source_tag.name %></span></div>
    <div is-="separator"></div>
    <div class="kv-row" style="padding: 0.5lh 1ch;"><span class="kv-label">Owner</span><span><%= @source_tag.owner.presence || "—" %></span></div>
  </div>

  <div class="footer-actions">
    <%= form_with url: source_tag_path(@source_tag), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this source tag?" }, class: "form-inline" do %>
      <button type="submit" variant-="red" size-="small">✕ Delete</button>
    <% end %>
  </div>

  <div class="back-link">
    <a href="<%= source_tags_path %>">← Back to source tags</a>
  </div>
</div>
