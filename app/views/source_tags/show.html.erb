<% content_for :title, @source_tag.name %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= source_tags_path %>" class="text-muted" style="text-decoration: none;">← Source Tags</a>
    <strong style="font-size: 1.15em;"><%= @source_tag.name %></strong>
    <code class="text-muted"><%= @source_tag.slug %></code>
  </div>
  <span class="spacer"></span>
  <a href="<%= edit_source_tag_path(@source_tag) %>">✎ Edit</a>
</div>

<div class="show-layout">
  <div class="show-main">
    <section>
      <strong>Details</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Slug</span>
        <code><%= @source_tag.slug %></code>
        <span class="detail-label">Name</span>
        <span><%= @source_tag.name %></span>
        <span class="detail-label">Owner</span>
        <span><%= @source_tag.owner.presence || "—" %></span>
        <span class="detail-label">Created</span>
        <span><%= @source_tag.created_at.strftime("%b %d, %Y %H:%M") %></span>
      </div>
    </section>
  </div>

  <div class="show-sidebar">
    <section>
      <strong>Actions</strong>
      <hr>
      <div style="margin-top: 0.5rem;">
        <a href="<%= edit_source_tag_path(@source_tag) %>" style="text-decoration: none;"><button style="width: 100%; margin-bottom: 0.5rem;">✎ Edit</button></a>
        <%= form_with url: source_tag_path(@source_tag), method: :delete, data: { turbo_confirm: "Delete this source tag?" }, class: "form-inline" do %>
          <button type="submit" class="btn-danger btn-sm" style="width: 100%;">✕ Delete</button>
        <% end %>
      </div>
    </section>
  </div>
</div>
