<%= form_with(model: source_tag) do |form| %>
  <% if source_tag.errors.any? %>
    <div box-="square" class="tui-banner tui-banner-error" style="margin-bottom: 1lh;">
      <strong>[!] <%= pluralize(source_tag.errors.count, "error") %>:</strong>
      <ul class="error-list">
        <% source_tag.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div box-="round" style="margin-bottom: 2lh;">
    <div style="padding: 1lh 1ch;">
      <div style="margin-bottom: 1lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Slug</label>
        <input type="text" name="source_tag[slug]" value="<%= source_tag.slug %>" style="width: 100%;">
      </div>

      <div style="margin-bottom: 1lh;">
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Name</label>
        <input type="text" name="source_tag[name]" value="<%= source_tag.name %>" style="width: 100%;">
      </div>

      <div>
        <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Owner</label>
        <input type="text" name="source_tag[owner]" value="<%= source_tag.owner %>" style="width: 100%;">
      </div>
    </div>
  </div>

  <div class="page-actions">
    <a href="<%= source_tags_path %>"><button type="button">Cancel</button></a>
    <button type="submit" variant-="green">✓ <%= source_tag.persisted? ? "Update Source Tag" : "Create Source Tag" %></button>
  </div>
<% end %>
