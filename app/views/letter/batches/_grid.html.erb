<div class="batch-grid" id="batch-grid"><% cells.each do |cell|
  icon = case cell[:state].to_s
         when "valid", "purchased" then "✓"
         when "error", "failed" then "x"
         when "warning" then "!"
         else " "
         end
%><span id="cell-<%= cell[:id] %>" class="batch-cell batch-cell-<%= cell[:state] %>"<% if cell[:title] %> title="<%= cell[:title] %>"<% end %><% if cell[:href] %> onclick="window.location='<%= cell[:href] %>'"<% end %>>[<%= icon %>]</span><% end %></div>
