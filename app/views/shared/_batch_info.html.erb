<% if record.batch.present? %>
  <% batch_path = record.batch.is_a?(Letter::Batch) ? letter_batch_path(record.batch) : warehouse_batch_path(record.batch) %>
  <div box-="round" style="margin-bottom: 1lh;">
    <strong>Batch</strong>
    <div is-="separator"></div>
    <div class="detail-grid" style="margin-top: 0.5lh;">
      <span class="detail-label">Batch</span>
      <span><a href="<%= batch_path %>"><%= record.batch.type.split('::').first.titleize %> Batch #<%= record.batch.id %></a></span>
      <span class="detail-label">Status</span>
      <span><%= render Components::Shared::StatusBadge.new(status: record.batch.aasm.current_state, type: :batch) %></span>
      <span class="detail-label">Created</span>
      <span><%= record.batch.created_at.strftime("%b %d, %Y") %></span>
      <span class="detail-label">Items</span>
      <span><%= record.batch.addresses.count %></span>
      <% if record.batch.is_a?(Letter::Batch) %>
        <span class="detail-label">Dimensions</span>
        <span><%= record.batch.letter_width %> × <%= record.batch.letter_height %> in, <%= record.batch.letter_weight %> oz</span>
      <% end %>
      <% if record.batch.is_a?(Warehouse::Batch) && record.batch.warehouse_template.present? %>
        <span class="detail-label">Template</span>
        <span><%= record.batch.warehouse_template.name %></span>
      <% end %>
    </div>
  </div>
<% end %>
