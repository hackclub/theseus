<% if record.batch.present? %>
  <div style="margin-top: 1lh;">
    <div box-="round">
      <row gap-="1" align-="center">
        <strong><%= record.batch.type.split('::').first.titleize %> Batch #<%= record.batch.id %></strong>
        <div style="flex: 1;"></div>
        <%= render Components::Shared::StatusBadge.new(status: record.batch.aasm.current_state, type: :batch) %>
        <% batch_path = record.batch.is_a?(Letter::Batch) ? letter_batch_path(record.batch) : warehouse_batch_path(record.batch) %>
        <a href="<%= batch_path %>" size-="small">View Batch →</a>
      </row>
      <div is-="separator"></div>
      <div class="detail-grid">
        <span class="detail-label">Created</span>
        <span><%= record.batch.created_at.strftime("%B %d, %Y") %></span>
        <span class="detail-label">Items in Batch</span>
        <span><%= record.batch.addresses.count %></span>
        <% if record.batch.is_a?(Letter::Batch) %>
          <span class="detail-label">Dimensions</span>
          <span><%= record.batch.letter_width %>" × <%= record.batch.letter_height %>"</span>
          <span class="detail-label">Weight</span>
          <span><%= record.batch.letter_weight %> oz</span>
        <% end %>
        <% if record.batch.is_a?(Warehouse::Batch) && record.batch.warehouse_template.present? %>
          <span class="detail-label">Template</span>
          <span><%= record.batch.warehouse_template.name %></span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
