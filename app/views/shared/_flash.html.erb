<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% banner_class = case type.to_sym
     when :success then "banner-success"
     when :notice, :info then "banner-info"
     when :warning then "banner-warning"
     when :alert, :error, :danger then "banner-error"
     else "banner-info"
     end %>
  <div class="banner <%= banner_class %>" style="margin-bottom: 1rem;"><%= message %></div>
<% end %>
