<h2 style="color: red;">⚠️ INSUFFICIENT FUNDS</h2>

<p><strong><%= @billing_profile.organization_name %></strong> can't pay for postage.</p>
<p><strong>Error:</strong> <%= @error %></p>

<h3>Unpaid postage entries:</h3>
<table border="1" cellpadding="4" cellspacing="0">
  <tr>
    <th>Category</th>
    <th>Amount</th>
    <th>Billable</th>
    <th>Created</th>
  </tr>
  <% @ledger_entries.each do |entry| %>
    <tr>
      <td><%= entry.category %></td>
      <td>$<%= "%.2f" % entry.amount %></td>
      <td><%= entry.ledgerable_type %> #<%= entry.ledgerable_id %></td>
      <td><%= entry.created_at.strftime("%b %d, %Y %H:%M") %></td>
    </tr>
  <% end %>
</table>

<p>Total owed: $<%= "%.2f" % (@ledger_entries.sum(&:amount_cents) / 100.0) %></p>
<p>This org needs to add funds before we can settle.</p>
