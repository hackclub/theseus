<div box-="round" style="margin-bottom: 1lh;">
  <strong>Letters</strong>
  <div is-="separator"></div>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="text-align: left;">Letter</th>
        <th style="text-align: left;">From</th>
        <th style="text-align: left;">Size</th>
        <th style="text-align: left;">Created</th>
        <th style="text-align: left;">Status</th>
      </tr>
    </thead>
    <tbody>
      <% letters.each do |letter| %>
        <tr>
          <td style="padding: 0.25lh 1ch;">
            <a href="<%= letter_path(letter) %>" style="font-weight: bold; text-decoration: none;"><%= letter.public_id %></a>
            <span class="row-tag"><%= letter.address.name_line %></span>
          </td>
          <td style="padding: 0.25lh 1ch; color: var(--foreground2);"><%= letter.return_address.present? ? letter.return_address_name_line : "—" %></td>
          <td style="padding: 0.25lh 1ch;"><%= letter.height %> × <%= letter.width %> in</td>
          <td style="padding: 0.25lh 1ch;"><%= letter.created_at.strftime(letter.created_at.year == Date.current.year ? "%b %d" : "%b %d, %Y") %></td>
          <td style="padding: 0.25lh 1ch;">
            <%= render Components::Shared::StatusBadge.new(status: letter.aasm_state, type: :letter) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
