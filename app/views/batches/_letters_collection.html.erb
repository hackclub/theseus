<div box-="round">
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="border-bottom: 1px solid var(--background3);">
        <th style="text-align: left; padding: 0.5lh 1ch; color: var(--foreground2);">Letter</th>
        <th style="text-align: left; padding: 0.5lh 1ch; color: var(--foreground2);">From</th>
        <th style="text-align: left; padding: 0.5lh 1ch; color: var(--foreground2);">Size</th>
        <th style="text-align: left; padding: 0.5lh 1ch; color: var(--foreground2);">Created</th>
        <th style="text-align: left; padding: 0.5lh 1ch; color: var(--foreground2);">Status</th>
      </tr>
    </thead>
    <tbody>
      <% letters.each do |letter| %>
        <tr style="border-bottom: 1px solid var(--background2);">
          <td style="padding: 0.5lh 1ch;">
            <%= link_to letter.public_id, letter, style: "font-weight: 500;" %>
            <span class="detail-label"> to <%= letter.address.name_line %></span>
          </td>
          <td style="padding: 0.5lh 1ch;" class="detail-label"><%= letter.return_address.present? ? letter.return_address_name_line : '—' %></td>
          <td style="padding: 0.5lh 1ch;"><%= letter.height %>" × <%= letter.width %>"</td>
          <td style="padding: 0.5lh 1ch;" class="detail-label"><%= time_ago_in_words(letter.created_at) %> ago</td>
          <td style="padding: 0.5lh 1ch;">
            <%= render Components::Shared::StatusBadge.new(status: letter.aasm_state, type: :letter) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
