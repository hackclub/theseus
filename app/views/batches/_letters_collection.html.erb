<section class="mb-1">
  <strong>Letters</strong>
  <hr>
  <table class="w-100">
    <thead>
      <tr>
        <th class="text-left">Letter</th>
        <th class="text-left">From</th>
        <th class="text-left">Size</th>
        <th class="text-left">Created</th>
        <th class="text-left">Status</th>
      </tr>
    </thead>
    <tbody>
      <% letters.each do |letter| %>
        <tr>
          <td class="cell-pad">
            <a href="<%= letter_path(letter) %>" class="link-bold"><%= letter.public_id %></a>
            <span class="row-tag"><%= letter.address.name_line %></span>
          </td>
          <td class="text-muted cell-pad"><%= letter.return_address.present? ? letter.return_address_name_line : "—" %></td>
          <td class="cell-pad"><%= letter.height %> × <%= letter.width %> in</td>
          <td class="cell-pad"><%= letter.created_at.strftime(letter.created_at.year == Date.current.year ? "%b %d" : "%b %d, %Y") %></td>
          <td class="cell-pad">
            <%= render Components::Shared::StatusBadge.new(status: letter.aasm_state, type: :letter) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
