<div box-="round">
  <% orders.each_with_index do |order, i| %>
    <% if i > 0 %><div is-="separator"></div><% end %>
    <div style="padding: 0.5lh 2ch;">
      <row gap-="1" align-="center">
        <div style="flex: 1; min-width: 0;">
          <row gap-="1" align-="center">
            <%= link_to order.hc_id, order, style: "font-weight: 500;" %>
            <span><%= order.user_facing_title %></span>
            <%= render 'warehouse/orders/status_badge', order: order %>
          </row>
          <div class="detail-label"><%= order.address.name_line %> (<%= order.recipient_email %>)</div>
          <% if order.tags.any? %>
            <div style="margin-top: 0.25lh;">
              <%= render 'shared/tags', tags: order.tags %>
            </div>
          <% end %>
        </div>
      </row>
    </div>
  <% end %>
</div>
