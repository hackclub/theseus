<section class="mb-1">
  <strong>Addresses</strong>
  <hr>
  <table class="w-100">
    <thead>
      <tr>
        <th class="text-left">Name</th>
        <th class="text-left">Address</th>
        <th class="text-left">City</th>
        <th class="text-left">State</th>
        <th class="text-left">Postal Code</th>
        <th class="text-left">Country</th>
      </tr>
    </thead>
    <tbody>
      <% addresses.each do |address| %>
        <tr>
          <td class="cell-pad"><%= "#{address.first_name} #{address.last_name}" %></td>
          <td class="cell-pad">
            <%= address.line_1 %>
            <% if address.line_2.present? %><br><%= address.line_2 %><% end %>
          </td>
          <td class="cell-pad"><%= address.city %></td>
          <td class="cell-pad"><%= address.state %></td>
          <td class="cell-pad"><code><%= address.postal_code %></code></td>
          <td class="cell-pad"><%= address.country %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
