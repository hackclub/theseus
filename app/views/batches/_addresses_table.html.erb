<div box-="round" style="margin-bottom: 1lh;">
  <strong>Addresses</strong>
  <div is-="separator"></div>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="text-align: left;">Name</th>
        <th style="text-align: left;">Address</th>
        <th style="text-align: left;">City</th>
        <th style="text-align: left;">State</th>
        <th style="text-align: left;">Postal Code</th>
        <th style="text-align: left;">Country</th>
      </tr>
    </thead>
    <tbody>
      <% addresses.each do |address| %>
        <tr>
          <td style="padding: 0.25lh 1ch;"><%= "#{address.first_name} #{address.last_name}" %></td>
          <td style="padding: 0.25lh 1ch;">
            <%= address.line_1 %>
            <% if address.line_2.present? %><br><%= address.line_2 %><% end %>
          </td>
          <td style="padding: 0.25lh 1ch;"><%= address.city %></td>
          <td style="padding: 0.25lh 1ch;"><%= address.state %></td>
          <td style="padding: 0.25lh 1ch;"><code><%= address.postal_code %></code></td>
          <td style="padding: 0.25lh 1ch;"><%= address.country %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
