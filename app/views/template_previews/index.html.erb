<% content_for :title, "Template Previews" %>

<div class="page-container">
  <h1 class="page-title content-section">Letter Template Previews</h1>

  <div box-="round">
    <% @templates.each do |template| %>
      <div class="resource-card" style="padding: 0.5lh 1ch; border-bottom: 1px solid var(--background2);">
        <div class="resource-card-info">
          <span class="resource-card-title"><%= template.to_s.split("::").last.humanize %></span>
          <code class="resource-card-meta"><%= template %></code>
        </div>
        <div class="page-actions">
          <a href="<%= template_preview_path(template) %>" size-="small" target="_blank">⎘ Preview PDF</a>
          <a href="<%= template_preview_path(template, qr: true) %>" size-="small" target="_blank">⎘ With QR</a>
        </div>
      </div>
    <% end %>
  </div>
</div>
