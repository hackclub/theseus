<% content_for :title, "Template Previews" %>

<div class="toolbar">
  <strong class="text-title">Letter Template Previews</strong>
  <span class="spacer"></span>
</div>

<table>
  <thead>
    <tr>
      <th>Template</th>
      <th>Class</th>
      <th class="text-right">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @templates.each do |template| %>
      <tr>
        <td><a href="<%= template_preview_path(template) %>" target="_blank" class="link-medium"><%= template.to_s.split("::").last.humanize %></a></td>
        <td><code class="text-muted"><%= template %></code></td>
        <td class="text-right">
          <div class="actions-end">
            <a href="<%= template_preview_path(template) %>" target="_blank">⎘ PDF</a>
            <a href="<%= template_preview_path(template, qr: true) %>" target="_blank">⎘ With QR</a>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
