<% content_for :title, "Customs Receipts" %>

<div class="page-container--narrow">
  <h1 class="page-title content-section">Generate Customs Receipt</h1>

  <div box-="round">
    <div style="padding: 1lh 1ch;">
      <%= form_with url: generate_customs_receipts_path, method: :get do |f| %>
        <div style="margin-bottom: 1lh;">
          <label style="display: block; color: var(--foreground2); margin-bottom: 0.25lh;">Search</label>
          <input type="text" name="search" placeholder="ID (recASDF/pkg!SDfJK) or original tracking number (ASnnnnn...)" style="width: 100%;">
        </div>

        <button type="submit" variant-="green">⎘ Generate</button>
      <% end %>
    </div>
  </div>
</div>
