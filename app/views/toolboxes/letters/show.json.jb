{
  id: @letter.public_id,
  title: @letter.display_name,
  state: @letter.aasm_state,
  body: @letter.body,
  user_facing_title: @letter.user_facing_title,
  recipient_email: @letter.recipient_email,
  tags: @letter.tags,
  postage_type: @letter.postage_type,
  postage: @letter.postage&.to_f,
  processing_category: @letter.processing_category,
  height: @letter.height&.to_f,
  width: @letter.width&.to_f,
  weight: @letter.weight&.to_f,
  non_machinable: @letter.non_machinable,
  rubber_stamps: @letter.rubber_stamps,
  mailing_date: @letter.mailing_date&.iso8601,
  created_via: @letter.created_via,
  has_label: @letter.label.attached?,
  indicia_state: @letter.indicia_state,
  address: @letter.address && {
    first_name: @letter.address.first_name,
    last_name: @letter.address.last_name,
    line_1: @letter.address.line_1,
    line_2: @letter.address.line_2,
    city: @letter.address.city,
    state: @letter.address.state,
    postal_code: @letter.address.postal_code,
    country: @letter.address.country
  },
  return_address: @letter.return_address && {
    id: @letter.return_address.id,
    name: @letter.return_address.name,
    line_1: @letter.return_address.line_1,
    line_2: @letter.return_address.line_2,
    city: @letter.return_address.city,
    state: @letter.return_address.state,
    postal_code: @letter.return_address.postal_code,
    country: @letter.return_address.country
  },
  return_address_name: @letter.return_address_name_line,
  printed_at: @letter.printed_at&.iso8601,
  mailed_at: @letter.mailed_at&.iso8601,
  received_at: @letter.received_at&.iso8601,
  created_at: @letter.created_at.iso8601,
  updated_at: @letter.updated_at.iso8601
}
