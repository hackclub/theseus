{
  id: @user.id,
  public_id: @user.public_id,
  username: @user.username,
  email: @user.email,
  permissions: {
    is_admin: @user.is_admin,
    is_warehouse_czar: @user.is_warehouse_czar,
    can_use_indicia: @user.can_use_indicia,
    can_warehouse: @user.can_warehouse,
    can_impersonate_public: @user.can_impersonate_public
  },
  slack_id: @user.slack_id,
  hca_id: @user.hca_id,
  icon_url: @user.icon_url,
  home_mid: @user.home_mid && {
    id: @user.home_mid.id,
    mid: @user.home_mid.mid
  },
  home_return_address: @user.home_return_address && {
    id: @user.home_return_address.id,
    name: @user.home_return_address.name
  },
  letter_count: @user.letters.count,
  warehouse_order_count: @user.warehouse_orders.count,
  created_at: @user.created_at,
  updated_at: @user.updated_at
}
