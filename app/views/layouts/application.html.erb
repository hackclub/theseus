<!DOCTYPE html>
<html data-webtui-theme="gruvbox-dark-hard">
  <head>
    <title><%= content_for(:title) || "Theseus" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function() {
        var sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var saved = localStorage.getItem('theme') || (sys ? 'gruvbox-dark-hard' : 'vitesse-light-soft');
        document.documentElement.dataset.webtuiTheme = saved;
      })();
    </script>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <%= vite_stylesheet_tag 'app_style.scss' %>
  </head>

  <body>
    <%= render Components::Shared::ActionBar.new %>
    <%= render Components::Shared::Sidebar.new(current_path: request.path) %>

    <div id="theseus-layout">
      <div id="theseus-content">
        <% if flash.any? %>
          <% flash.each do |type, message| %>
            <div box-="square" class="tui-banner tui-banner-<%= flash_banner_class(type) %>" style="margin-bottom: 1lh;">
              [<%= flash_banner_icon(type) %>] <%= message %>
            </div>
          <% end %>
        <% end %>

        <%= yield %>
      </div>
    </div>

    <div id="theseus-env"><%= Rails.env %></div>

    <% if current_user %>
      <!-- erblint:disable ScriptType -->
      <script type="application/json" id="kbar-data"><%= raw Shortcodes.kbar_data_for(current_user) %></script>
      <script type="application/json" id="keyboard-shortcuts-data"><%= raw(keyboard_shortcuts_data.to_json) %></script>
      <!-- erblint:enable ScriptType -->
      <div data-svelte-component="command-palette"></div>
      <div data-svelte-component="hints-modal"></div>
      <div data-svelte-component="keyboard-shortcuts"></div>
    <% end %>
  </body>
</html>
