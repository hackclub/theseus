<%= form_with(model: usps_indicium) do |form| %>
  <% if usps_indicium.errors.any? %>
    <div class="mb-1" style="color: var(--red)">
      [!] <strong><%= pluralize(usps_indicium.errors.count, "error") %>:</strong>
      <ul style="margin: 0; padding-left: 1rem;">
        <% usps_indicium.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="mb-1">
    <strong>Postage</strong>
    <hr>
    <div class="mt-half">
      <div style="display:flex;gap:1rem">
        <div style="flex: 1;">
          <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Postage</label>
          <input type="text" name="usps_indicium[postage]" value="<%= usps_indicium.postage %>" class="w-100">
        </div>
        <div style="flex: 1;">
          <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Mailing Date</label>
          <%= form.date_field :mailing_date, style: "width: 100%;" %>
        </div>
      </div>
      <div class="mt-1" style="display:flex; gap:1rem">
        <div style="flex: 1;">
          <label class="text-muted" style="display: block; margin-bottom: 0.25rem">USPS SKU</label>
          <input type="text" name="usps_indicium[usps_sku]" value="<%= usps_indicium.usps_sku %>" class="w-100">
        </div>
        <div style="flex: 1;">
          <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Processing Category</label>
          <input type="text" name="usps_indicium[processing_category]" value="<%= usps_indicium.processing_category %>" class="w-100">
        </div>
      </div>
    </div>
  </section>

  <section class="mb-1">
    <strong>Dimensions</strong>
    <hr>
    <div class="mt-half">
      <div style="display:flex;gap:1rem">
        <div style="flex: 1;">
          <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Weight (oz)</label>
          <input type="text" name="usps_indicium[postage_weight]" value="<%= usps_indicium.postage_weight %>" class="w-100">
        </div>
      </div>
      <div class="mt-1">
        <label><input type="checkbox" name="usps_indicium[nonmachinable]" value="1" <%= "checked" if usps_indicium.nonmachinable %>> Non-machinable</label>
      </div>
    </div>
  </section>

  <section class="mb-1">
    <strong>Raw Response</strong>
    <hr>
    <div class="mt-half">
      <label class="text-muted" style="display: block; margin-bottom: 0.25rem">Raw USPS response</label>
      <textarea name="usps_indicium[raw_json_response]" rows="4" class="w-100"><%= usps_indicium.raw_json_response %></textarea>
    </div>
  </section>

  <div style="display:flex;align-items:center;gap:0.5rem;justify-content: flex-end;">
    <a href="<%= usps_indicia_path %>" class="text-muted" style="text-decoration: none;">Cancel</a>
    <button type="submit" class="btn-success"><%= usps_indicium.persisted? ? "Update Indicium" : "Create Indicium" %></button>
  </div>
<% end %>
