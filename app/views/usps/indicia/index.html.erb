<% content_for :title, "Indicia" %>

<div class="toolbar">
  <div class="flex-row">
    <strong class="text-title">Indicia</strong>
    <span class="text-muted"><%= number_with_delimiter(@usps_indicia.count) %> purchased</span>
  </div>
  <span class="spacer"></span>
  <a href="<%= new_usps_indicium_path %>"><button class="btn-success">+ New Indicium</button></a>
</div>

<% if @usps_indicia.any? %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>SKU</th>
        <th class="text-right">Postage</th>
        <th>Date</th>
        <th>Category</th>
      </tr>
    </thead>
    <tbody>
      <% @usps_indicia.each do |indicium| %>
        <tr>
          <td><a href="<%= usps_indicium_path(indicium) %>" class="no-underline"><strong><%= indicium.public_id %></strong></a></td>
          <td><code><%= indicium.usps_sku %></code></td>
          <td class="text-right tabular"><%= number_to_currency(indicium.postage) %></td>
          <td class="text-muted"><%= indicium.mailing_date&.strftime("%b %d") || "—" %></td>
          <td class="text-muted"><%= indicium.processing_category || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <section class="empty-state">
    <strong>No indicia yet</strong>
    <div class="text-muted mt-quarter">Purchased postage will appear here.</div>
  </section>
<% end %>
