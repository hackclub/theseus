<% content_for :title, "Indicia" %>

<div class="page-toolbar">
  <row gap-="1" align-="center">
    <strong style="font-size: 1.15em;">Indicia</strong>
    <span style="color: var(--foreground2);"><%= number_with_delimiter(@usps_indicia.count) %> purchased</span>
  </row>
  <span class="toolbar-spacer"></span>
  <a href="<%= new_usps_indicium_path %>"><button variant-="green">+ New Indicium</button></a>
</div>

<% if @usps_indicia.any? %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>SKU</th>
        <th style="text-align: right;">Postage</th>
        <th>Date</th>
        <th>Category</th>
      </tr>
    </thead>
    <tbody>
      <% @usps_indicia.each do |indicium| %>
        <tr>
          <td><a href="<%= usps_indicium_path(indicium) %>" style="text-decoration: none;"><strong><%= indicium.public_id %></strong></a></td>
          <td><code><%= indicium.usps_sku %></code></td>
          <td style="text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(indicium.postage) %></td>
          <td style="color: var(--foreground2);"><%= indicium.mailing_date&.strftime("%b %d") || "—" %></td>
          <td style="color: var(--foreground2);"><%= indicium.processing_category || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div box-="round" style="text-align: center; padding: 2lh 2ch;">
    <strong>No indicia yet</strong>
    <div style="color: var(--foreground2); margin-top: 0.25lh;">Purchased postage will appear here.</div>
  </div>
<% end %>
