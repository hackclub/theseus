<% content_for :title, "Indicia" %>

<div class="toolbar">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <strong style="font-size: 1.15em;">Indicia</strong>
    <span class="text-muted"><%= number_with_delimiter(@usps_indicia.count) %> purchased</span>
  </div>
  <span class="spacer"></span>
  <a href="<%= new_usps_indicium_path %>"><button class="btn-success">+ New Indicium</button></a>
</div>

<% if @usps_indicia.any? %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>SKU</th>
        <th style="text-align: right;">Postage</th>
        <th>Date</th>
        <th>Category</th>
      </tr>
    </thead>
    <tbody>
      <% @usps_indicia.each do |indicium| %>
        <tr>
          <td><a href="<%= usps_indicium_path(indicium) %>" style="text-decoration: none;"><strong><%= indicium.public_id %></strong></a></td>
          <td><code><%= indicium.usps_sku %></code></td>
          <td style="text-align: right; font-variant-numeric: tabular-nums;"><%= number_to_currency(indicium.postage) %></td>
          <td class="text-muted"><%= indicium.mailing_date&.strftime("%b %d") || "—" %></td>
          <td class="text-muted"><%= indicium.processing_category || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <section style="text-align: center; padding: 2rem;">
    <strong>No indicia yet</strong>
    <div class="text-muted" style="margin-top: 0.25rem;">Purchased postage will appear here.</div>
  </section>
<% end %>
