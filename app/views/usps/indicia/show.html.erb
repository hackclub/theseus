<% content_for :title, "Indicium #{@usps_indicium.public_id}" %>

<div class="toolbar mb-0 no-border-bottom">
  <div class="flex-row">
    <a href="<%= usps_indicia_path %>" class="text-muted no-underline">← Indicia</a>
    <strong class="text-title">Indicium</strong>
    <%= render Components::Shared::PublicId.new(value: @usps_indicium.public_id) %>
  </div>
  <span class="spacer"></span>
  <div class="flex-row">
    <a href="<%= edit_usps_indicium_path(@usps_indicium) %>">✎ Edit</a>
    <%= form_with url: usps_indicium_path(@usps_indicium), method: :delete, data: { turbo_confirm: "Delete this indicium?" }, class: "form-inline" do %>
      <button type="submit" class="btn-danger btn-sm">✕</button>
    <% end %>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <section class="mb-1">
      <strong>Postage Details</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">Postage</span>
        <span><%= number_to_currency(@usps_indicium.postage) %></span>
        <span class="detail-label">Fees</span>
        <span><%= @usps_indicium.fees ? number_to_currency(@usps_indicium.fees) : "—" %></span>
        <span class="detail-label">Total Cost</span>
        <span><%= number_to_currency(@usps_indicium.cost) %></span>
        <span class="detail-label">Mailing Date</span>
        <span><%= @usps_indicium.mailing_date&.strftime("%b %d, %Y") || "—" %></span>
        <span class="detail-label">USPS SKU</span>
        <span><code><%= @usps_indicium.usps_sku || "—" %></code></span>
        <span class="detail-label">Category</span>
        <span><%= @usps_indicium.processing_category || "—" %></span>
      </div>
    </section>

    <section class="mb-1">
      <strong>Dimensions</strong>
      <hr>
      <div class="detail-grid mt-half">
        <span class="detail-label">Weight</span>
        <span><%= @usps_indicium.postage_weight %> oz</span>
        <% if @usps_indicium.letter %>
          <span class="detail-label">Length</span>
          <span><%= @usps_indicium.letter.width %>"</span>
          <span class="detail-label">Height</span>
          <span><%= @usps_indicium.letter.height %>"</span>
        <% end %>
        <span class="detail-label">Non-machinable</span>
        <span><%= @usps_indicium.nonmachinable ? "Yes" : "No" %></span>
      </div>
    </section>

    <%= render partial: "admin_inspector", locals: { record: @usps_indicium } %>
  </div>

  <div class="show-sidebar">
    <section class="mb-1">
      <strong>Actions</strong>
      <hr>
      <div class="mt-half">
        <a href="<%= edit_usps_indicium_path(@usps_indicium) %>"><button class="w-100 mb-half">✎ Edit Indicium</button></a>
        <%= form_with url: usps_indicium_path(@usps_indicium), method: :delete, data: { turbo_confirm: "Delete this indicium?" } do %>
          <button type="submit" class="btn-danger btn-sm w-100">✕ Delete</button>
        <% end %>
      </div>
    </section>
  </div>
</div>
