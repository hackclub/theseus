<% content_for :title, "Mailer IDs" %>

<div class="page-container">
  <div class="page-header">
    <div>
      <h1 class="page-title">CRID / Mailer ID Pairs</h1>
      <p class="page-subtitle"><%= @usps_mailer_ids.count %> registered</p>
    </div>
    <a href="<%= new_usps_mailer_id_path %>" variant-="green">+ New Mailer ID</a>
  </div>

  <% if @usps_mailer_ids.any? %>
    <div box-="round">
      <% @usps_mailer_ids.each do |mid| %>
        <a href="<%= usps_mailer_id_path(mid) %>" class="resource-card link-reset" style="display: block; padding: 0.5lh 1ch; border-bottom: 1px solid var(--background2);">
          <span class="resource-card-title"><%= mid.name %></span>
          <div class="resource-card-meta mailer-id-codes">
            <span>CRID: <code><%= mid.crid %></code></span>
            <span>MID: <code><%= mid.mid %></code></span>
          </div>
        </a>
      <% end %>
    </div>
  <% else %>
    <div box-="round" style="text-align: center; padding: 2lh 2ch;">
      <h3 style="margin: 0;">No mailer IDs yet</h3>
      <p style="color: var(--foreground2);"><a href="<%= new_usps_mailer_id_path %>">Add one</a></p>
    </div>
  <% end %>
</div>
