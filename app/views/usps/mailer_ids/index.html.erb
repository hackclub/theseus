<% content_for :title, "Mailer IDs" %>

<div class="toolbar">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <strong style="font-size: 1.15em;">CRID / Mailer ID Pairs</strong>
    <span class="text-muted"><%= number_with_delimiter(@usps_mailer_ids.count) %> registered</span>
  </div>
  <span class="spacer"></span>
  <a href="<%= new_usps_mailer_id_path %>"><button class="btn-success">+ New Mailer ID</button></a>
</div>

<% if @usps_mailer_ids.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>CRID</th>
        <th>MID</th>
      </tr>
    </thead>
    <tbody>
      <% @usps_mailer_ids.each do |mid| %>
        <tr>
          <td><a href="<%= usps_mailer_id_path(mid) %>" style="text-decoration: none;"><strong><%= mid.name %></strong></a></td>
          <td><code><%= mid.crid %></code></td>
          <td><code><%= mid.mid %></code></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <section style="text-align: center; padding: 2rem;">
    <strong>No mailer IDs yet</strong>
    <div class="text-muted" style="margin-top: 0.25rem;"><a href="<%= new_usps_mailer_id_path %>">Add one</a></div>
  </section>
<% end %>
