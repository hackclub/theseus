<% content_for :title, "Mailer IDs" %>

<div class="page-toolbar">
  <row gap-="1" align-="center">
    <strong style="font-size: 1.15em;">CRID / Mailer ID Pairs</strong>
    <span style="color: var(--foreground2);"><%= number_with_delimiter(@usps_mailer_ids.count) %> registered</span>
  </row>
  <span class="toolbar-spacer"></span>
  <a href="<%= new_usps_mailer_id_path %>"><button variant-="green">+ New Mailer ID</button></a>
</div>

<% if @usps_mailer_ids.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>CRID</th>
        <th>MID</th>
      </tr>
    </thead>
    <tbody>
      <% @usps_mailer_ids.each do |mid| %>
        <tr>
          <td><a href="<%= usps_mailer_id_path(mid) %>" style="text-decoration: none;"><strong><%= mid.name %></strong></a></td>
          <td><code><%= mid.crid %></code></td>
          <td><code><%= mid.mid %></code></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div box-="round" style="text-align: center; padding: 2lh 2ch;">
    <strong>No mailer IDs yet</strong>
    <div style="color: var(--foreground2); margin-top: 0.25lh;"><a href="<%= new_usps_mailer_id_path %>">Add one</a></div>
  </div>
<% end %>
