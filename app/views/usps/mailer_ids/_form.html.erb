<%= form_with(model: usps_mailer_id) do |form| %>
  <% if usps_mailer_id.errors.any? %>
    <div style="margin-bottom: 1rem; color: var(--red);">
      [!] <strong><%= pluralize(usps_mailer_id.errors.count, "error") %>:</strong>
      <ul style="margin: 0; padding-left: 1rem;">
        <% usps_mailer_id.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section style="margin-bottom: 1rem;">
    <strong>Details</strong>
    <hr>
    <div style="margin-top: 0.5rem;">
      <div style="margin-bottom: 1rem;">
        <label style="display: block; color: GrayText; margin-bottom: 0.25rem;">Name</label>
        <input type="text" name="usps_mailer_id[name]" value="<%= usps_mailer_id.name %>" style="width: 100%;">
      </div>
      <div style="display:flex;gap:1rem">
        <div style="flex: 1;">
          <label style="display: block; color: GrayText; margin-bottom: 0.25rem;">CRID</label>
          <input type="text" name="usps_mailer_id[crid]" value="<%= usps_mailer_id.crid %>" style="width: 100%;">
        </div>
        <div style="flex: 1;">
          <label style="display: block; color: GrayText; margin-bottom: 0.25rem;">MID</label>
          <input type="text" name="usps_mailer_id[mid]" value="<%= usps_mailer_id.mid %>" style="width: 100%;">
        </div>
      </div>
    </div>
  </section>

  <div style="display:flex;align-items:center;gap:0.5rem;justify-content: flex-end;">
    <a href="<%= usps_mailer_ids_path %>" class="text-muted" style="text-decoration: none;">Cancel</a>
    <button type="submit" class="btn-success"><%= usps_mailer_id.persisted? ? "Update Mailer ID" : "Create Mailer ID" %></button>
  </div>
<% end %>
