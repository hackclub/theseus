<% content_for :title, "USPS Payment Accounts" %>

<div class="toolbar">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <strong style="font-size: 1.15em;">USPS Payment Accounts</strong>
    <span class="text-muted"><%= number_with_delimiter(@usps_payment_accounts.count) %> accounts</span>
  </div>
  <span class="spacer"></span>
  <a href="<%= new_usps_payment_account_path %>"><button class="btn-success">+ New Account</button></a>
</div>

<% if @usps_payment_accounts.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Mailer ID</th>
      </tr>
    </thead>
    <tbody>
      <% @usps_payment_accounts.each do |account| %>
        <tr>
          <td><a href="<%= usps_payment_account_path(account) %>" style="text-decoration: none;"><strong><%= account.display_name %></strong></a></td>
          <td><span class="badge"><%= account.account_type %></span></td>
          <td class="text-muted"><%= account.usps_mailer_id&.name || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <section style="text-align: center; padding: 2rem;">
    <strong>No payment accounts yet</strong>
    <div class="text-muted" style="margin-top: 0.25rem;"><a href="<%= new_usps_payment_account_path %>">Add one</a></div>
  </section>
<% end %>
