<% content_for :title, "USPS Payment Accounts" %>

<div class="page-container">
  <div class="page-header">
    <div>
      <h1 class="page-title">USPS Payment Accounts</h1>
      <p class="page-subtitle"><%= @usps_payment_accounts.count %> accounts</p>
    </div>
    <a href="<%= new_usps_payment_account_path %>" variant-="green">+ New Account</a>
  </div>

  <% if @usps_payment_accounts.any? %>
    <div box-="round">
      <% @usps_payment_accounts.each do |account| %>
        <a href="<%= usps_payment_account_path(account) %>" class="resource-card link-reset" style="display: block; padding: 0.5lh 1ch; border-bottom: 1px solid var(--background2);">
          <span class="resource-card-title"><%= account.display_name %></span>
          <span is-="badge" variant-="background2"><%= account.account_type %></span>
        </a>
      <% end %>
    </div>
  <% else %>
    <div box-="round" style="text-align: center; padding: 2lh 2ch;">
      <h3 style="margin: 0;">No payment accounts yet</h3>
      <p style="color: var(--foreground2);"><a href="<%= new_usps_payment_account_path %>">Add one</a></p>
    </div>
  <% end %>
</div>
