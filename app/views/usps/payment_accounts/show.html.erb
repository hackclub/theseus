<% content_for :title, @usps_payment_account.display_name %>

<div class="toolbar" style="border-bottom: none; margin-bottom: 0;">
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= usps_payment_accounts_path %>" class="text-muted" style="text-decoration: none;">← Payment Accounts</a>
    <strong style="font-size: 1.15em;"><%= @usps_payment_account.display_name %></strong>
    <span class="badge"><%= @usps_payment_account.account_type %></span>
  </div>
  <span class="spacer"></span>
  <div style="display:flex;align-items:center;gap:0.5rem">
    <a href="<%= edit_usps_payment_account_path(@usps_payment_account) %>">✎ Edit</a>
    <%= form_with url: usps_payment_account_path(@usps_payment_account), method: :delete, data: { turbo_confirm: "Delete this payment account?" }, class: "form-inline" do %>
      <button type="submit" class="btn-danger btn-sm">✕</button>
    <% end %>
  </div>
</div>

<div class="show-layout">
  <div class="show-main">
    <section style="margin-bottom: 1rem;">
      <strong>Account Details</strong>
      <hr>
      <div class="detail-grid" style="margin-top: 0.5rem;">
        <span class="detail-label">Name</span>
        <span><%= @usps_payment_account.name %></span>
        <span class="detail-label">Account Type</span>
        <span><%= @usps_payment_account.account_type %></span>
        <% if @usps_payment_account.account_number.present? %>
          <span class="detail-label">Account Number</span>
          <span><code><%= @usps_payment_account.account_number %></code></span>
        <% end %>
        <% if @usps_payment_account.permit_number.present? %>
          <span class="detail-label">Permit Number</span>
          <span><code><%= @usps_payment_account.permit_number %></code></span>
        <% end %>
        <% if @usps_payment_account.permit_zip.present? %>
          <span class="detail-label">Permit ZIP</span>
          <span><code><%= @usps_payment_account.permit_zip %></code></span>
        <% end %>
        <span class="detail-label">Manifest MID</span>
        <span><code><%= @usps_payment_account.manifest_mid || "—" %></code></span>
        <span class="detail-label">Mailer ID</span>
        <span><%= @usps_payment_account.usps_mailer_id&.name || "—" %></span>
      </div>
    </section>

    <%= render partial: "admin_inspector", locals: { record: @usps_payment_account } %>
  </div>

  <div class="show-sidebar">
    <section style="margin-bottom: 1rem;">
      <strong>Actions</strong>
      <hr>
      <div style="margin-top: 0.5rem;">
        <a href="<%= edit_usps_payment_account_path(@usps_payment_account) %>"><button style="width: 100%; margin-bottom: 0.5rem;">✎ Edit Account</button></a>
        <%= form_with url: usps_payment_account_path(@usps_payment_account), method: :delete, data: { turbo_confirm: "Delete this payment account?" } do %>
          <button type="submit" class="btn-danger btn-sm" style="width: 100%;">✕ Delete</button>
        <% end %>
      </div>
    </section>
  </div>
</div>
